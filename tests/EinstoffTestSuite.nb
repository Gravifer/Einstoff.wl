Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"R", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "16", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], "}"}], 
   ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<ArrayContract\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",", 
     RowBox[{"{", "R", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->354805560,ExpressionUUID->"a2ff2376-9c67-724b-86f2-eaff6b23a597"],

