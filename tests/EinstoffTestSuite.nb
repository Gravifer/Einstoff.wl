     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"a_", ",", "b_", ",", "a_"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{", "c", "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "]"}], ",",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->967619636],

