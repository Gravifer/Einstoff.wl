Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"\"\<q\>\"", "\[CirclePlus]", "k_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"\"\<q\>\"", ",", "b"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "x", "}"}], ",",
     RowBox[{"{",
      RowBox[{"\"\<q\>\"", "\[Rule]", "3"}], "}"}]}], "]"}]}],
