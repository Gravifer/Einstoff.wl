Cell["\<\
24. A previously returned result must NOT decay when a later operation runs: \
the
boundary purge is CLEAR-ONLY (never Remove), so a synthetic Einstoff`Axis` \
token
that is a live key in an earlier env / Bindings is not rewritten to Removed[\
\[Ellipsis]].
(Regression: a Remove-based purge corrupted m[\"env\"] into \
<|Removed[\"keepold\"]->5|>.)\
\>", "Text",
 CellID->181306123,ExpressionUUID->"e6edb7ab-5e7a-b54a-aabd-3f0cf309b818"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", ",", "s"}], "}"}], ",", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"keepold", "=", "1"}], "}"}], ",", 
       RowBox[{"Einstoff`EinstoffMatch", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", "\"\<keepold\>\"", "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", "5", "}"}], "}"}]}], "]"}]}], "]"}]}], ";", 
    RowBox[{"s", "=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"keepold2", "=", "1"}], "}"}], ",", 
       RowBox[{"Einstoff`EinstoffShapes", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", "\"\<keepold2\>\"", "}"}], "}"}], "\[RuleDelayed]", 
          RowBox[{"{", 
           RowBox[{"{", "\"\<keepold2\>\"", "}"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"{", "5", "}"}], "}"}]}], "]"}]}], "]"}]}], ";", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nextop", "=", "1"}], "}"}], ",", 
      RowBox[{"Einstoff`EinstoffMatch", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", "\"\<nextop\>\"", "}"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", "7", "}"}], "}"}]}], "]"}]}], "]"}], ";", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"Keys", "[", 
         RowBox[{"m", "[", "\"\<env\>\"", "]"}], "]"}], ",", "_Removed"}], 
       "]"}], ",", 
      RowBox[{
       RowBox[{"m", "[", "\"\<env\>\"", "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], ",", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"Keys", "[", 
         RowBox[{"s", "[", "\"\<Bindings\>\"", "]"}], "]"}], ",", 
        "_Removed"}], "]"}]}], "}"}]}]}], "]"}]], "VerificationTest",
 CellID->740029612,ExpressionUUID->"47c356b4-2e45-2244-a1c9-952361f36d9c"],

