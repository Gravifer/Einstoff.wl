Cell["Dot.wlt", "Section",
 CellID->140953783,ExpressionUUID->"407a0c91-a0e3-b84b-8e85-70383f4533b6"],

Cell["\<\
Cross-validation tests for the dot lowering: Einstoff[Dot] checked against \
the
actual einx.dot contraction (SPEC \[Section]10.1). Companion to the other
tests/python/*.wlt; see Reshape.wlt for the full rationale.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Integer inputs -> exact equality, no tolerance.

The session setup / pyDims helpers are intentionally duplicated from the \
other
python suites to keep each .wlt self-contained; factor into a shared harness
if this duplication grows.\
\>", "Text",
 CellID->221837149,ExpressionUUID->"170b8344-5d0c-1647-8c93-bbc9068373a6"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "r"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->467129298,ExpressionUUID->"24ad274f-9844-064e-a5fd-a27df27c77d3"],

Cell[BoxData[
 RowBox[{"pyRoot", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",", 
    "Einstoff`Tests`$Root", ",", 
    RowBox[{"ParentDirectory", "[", 
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}], 
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->19433322,ExpressionUUID->"18ce96ff-929c-8c4a-b6b0-c166b0e5865b"],

Cell[BoxData[
 RowBox[{"pyExe", "=", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"", 
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->946564416,ExpressionUUID->"f7cac466-ae25-7443-9eed-1ada4d326902"],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->209707798,ExpressionUUID->"3070323a-c227-c64a-aad7-167fa9a1316c"],

Cell[BoxData[
 RowBox[{"pyOwned", "=", 
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=", 
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->769483126,ExpressionUUID->"9661eb45-5fee-3a4e-abd4-42d7bc74555c"],

Cell[BoxData[
 RowBox[{"pySession", "=", 
  RowBox[{"If", "[", 
   RowBox[{"pyOwned", ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",", 
         RowBox[{"StartExternalSession", "[", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}], 
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->817607051,ExpressionUUID->"b17e4966-49a9-d94f-92cb-fda8fb579279"],

Cell[BoxData[
 RowBox[{"pythonReady", "=", 
  RowBox[{"TrueQ", "[", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===", 
        "ExternalSessionObject"}], "&&", 
       RowBox[{
        RowBox[{"ExternalEvaluate", "[", 
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}], 
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->345306569,ExpressionUUID->"6e2ed543-ebf4-b246-91cd-f6a8cea7836c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=", 
  RowBox[{"\"\<[\>\"", "<>", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}], 
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->153125350,ExpressionUUID->"1414a1e8-4edf-3140-8c5a-c1ef356fefa8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyKwargs", "[", "kw_Association", "]"}], ":=", 
  RowBox[{"StringRiffle", "[", 
   RowBox[{
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "<>", "\"\<=\>\"", "<>", 
        RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kw"}], "]"}], 
    ",", "\"\<, \>\""}], "]"}]}]], "Input",
 InitializationCell->True,
