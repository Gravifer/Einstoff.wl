  RowBox[{
   RowBox[{"Einstoff", "[", "Dot", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "b_", ",", "a_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"{", "c", "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}], 
  "]"}]], "VerificationTest",
 CellID->12293562,ExpressionUUID->"03d154bf-7bc6-9344-9a71-f42da190b3a9"],

