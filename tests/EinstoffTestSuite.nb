       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{"Take", "[",
      RowBox[{"x", ",", "All", ",",
       RowBox[{"{",
        RowBox[{"1", ",", "3"}], "}"}]}], "]"}], ",",
     RowBox[{"Take", "[",
      RowBox[{"x", ",", "All", ",",
