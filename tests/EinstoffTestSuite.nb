Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{"With", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"g", "=",
       RowBox[{
        RowBox[{"Einstoff", "[", "Join", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"m_", ",", "a_"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"m_", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"m", ",",
             RowBox[{"a", "\[CirclePlus]", "b"}]}], "}"}], "}"}]}], ",",
         RowBox[{"{",
          RowBox[{"x", ",", "y"}], "}"}], ",",
         RowBox[{"{", "}"}], ",",
         RowBox[{"TraceAction", "\[Rule]", "Hold"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "_Join"}], "]"}]}], ",",
       RowBox[{
        RowBox[{"ReleaseHold", "[", "g", "]"}], "===",
        RowBox[{"Join", "[",
         RowBox[{"x", ",", "y", ",", "2"}], "]"}]}], ",",
       RowBox[{"FreeQ", "[",
        RowBox[{"g", ",", "_Einstoff`PackageScope`materializeOutput"}],
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->271198508],

