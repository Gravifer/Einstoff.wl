  RowBox[{
   RowBox[{
    RowBox[{"{",
     RowBox[{"{", "a_", "}"}], "}"}], "\[RuleDelayed]",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
   RowBox[{"{",
    RowBox[{"Range", "[", "4", "]"}], "}"}], ",",
   RowBox[{"{",
    RowBox[{"c", "\[Rule]", "3"}], "}"}]}], "]"}]], "VerificationTest",
