Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], ",",
     RowBox[{"sm", "=",
      RowBox[{
       FractionBox[
        RowBox[{"Exp", "[",
         RowBox[{"#1", "-",
          RowBox[{"Max", "[", "#1", "]"}]}], "]"}],
        RowBox[{"Total", "[",
         RowBox[{"Exp", "[",
          RowBox[{"#1", "-",
           RowBox[{"Max", "[", "#1", "]"}]}], "]"}], "]"}]], "&"}]}]}], "}"}],
    ",",
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<softmax\>\"", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"a", ",", "#b"}], "}"}], "}"}]}], ",",
      RowBox[{"{", "x", "}"}]}], "]"}], "===",
    RowBox[{"sm", "/@", "x"}]}]}], "]"}]], "VerificationTest",
 CellID->727505227],

