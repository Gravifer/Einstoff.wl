Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{"With", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"g", "=",
       RowBox[{
        RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"a_", ",", "b_"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
         RowBox[{"{",
          RowBox[{"x", ",", "y"}], "}"}], ",",
         RowBox[{"{", "}"}], ",",
         RowBox[{"TraceAction", "\[Rule]", "Hold"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "_MapThread"}], "]"}]}], ",",
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "Dot"}], "]"}]}], ",",
       RowBox[{
        RowBox[{"ReleaseHold", "[", "g", "]"}], "===",
        RowBox[{
         RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
         RowBox[{
          RowBox[{
           RowBox[{"{",
            RowBox[{
             RowBox[{"{",
              RowBox[{"a_", ",", "b_"}], "}"}], ",",
             RowBox[{"{",
              RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
          RowBox[{"{",
           RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ",",
       RowBox[{"FreeQ", "[",
        RowBox[{"g", ",", "_Einstoff`PackageScope`materializeOutput"}],
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->205149417],

