     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"a_", ",", "2"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
