       RowBox[{"Range", "[", "18", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",

    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a_", ",",
         FrameBox[
