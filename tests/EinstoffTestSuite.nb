flip
reverses the whole flattened block (cf. SPEC 7.3).\
\>", "Text",
 CellID->407018604],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"z", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a_", ",", "#b", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]",

      RowBox[{"{",
       RowBox[{"{",
