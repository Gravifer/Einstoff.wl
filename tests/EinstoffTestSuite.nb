Cell["\<\
7b. Multiple direct-sum axes enumerate Cartesian blocks, last axis fastest:
'a b, a c, d b, d c -> (a + d) (b + c)'.\
\>", "Text",
 CellID->275820198],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x11", "=",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"0", ",", "1"}], "}"}], "}"}]}], ",",
     RowBox[{"x12", "=",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"10", ",", "11", ",", "12"}], "}"}], "}"}]}], ",",
     RowBox[{"x21", "=",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"20", ",", "21"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"22", ",", "23"}], "}"}]}], "}"}]}], ",",
     RowBox[{"x22", "=",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"30", ",", "31", ",", "32"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"33", ",", "34", ",", "35"}], "}"}]}], "}"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"a_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"a_", ",", "c_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"d_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"d_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{
         RowBox[{"a", "\[CirclePlus]", "d"}], ",",
         RowBox[{"b", "\[CirclePlus]", "c"}]}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"x11", ",", "x12", ",", "x21", ",", "x22"}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->792323267],

