Cell["\<\
9. Inner shares innerLower's Option-A operand sanitize: a size > 1 literal is \
not a
shared contraction identity (two '2's are not the same axis) \[LongDash] \
reject, like Dot.\
\>", "Text",
 CellID->65600960],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
     RowBox[{"Plus", ",", "Min"}], "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"a_", ",", "2"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "2"}], "}"}]}], "]"}], ",",
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",",
   RowBox[{"{",
    StyleBox[
     RowBox[{"Einstoff", "::", "unsupp"}], "MessageName"], "}"}]}],
