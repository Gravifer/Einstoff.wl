Cell["\<\
===================== composite summands (split) ===============\
\>", "Text",
 CellID->693219501],

Cell["\<\
Splitting a product block needs the block's factors bound so the matcher can
determine the remaining summand. The CAS (Solve over positive integers) handles
the arithmetic \[LongDash] and resolves any system the integers pin uniquely \
(see #31).\
\>", "Text",
 CellID->176412838],

Cell["\<\
28. Split a product block: 'm ((a b) + c) -> m (a b), m c', a=2, b=3 (=> c=4).\
\>", "Text",
 CellID->708690532],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"z", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"m_", ",",
         RowBox[{
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], "\[CirclePlus]",
           "c_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"m", ",",
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}]}], "}"}], ",",

        RowBox[{"{",
         RowBox[{"m", ",", "c"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "z", "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "2"}], ",",
       RowBox[{"\"\<b\>\"", "\[Rule]", "3"}]}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->538859906],

Cell[BoxData[
 RowBox[{"With", "[",
