Cell["\<\
10b. A name repeated *within a single operand* ('a' in operand 1) is \
within-tensor
contraction \[LongDash] Dot contracts *across* operands, not within one, so \
it is rejected (Dot's
own policy; EinstoffShapes no longer gates it).  'b' is a legitimate \
cross-operand
contracted axis and must NOT trip the guard (firstDuplicateAxis is per-shape).\
\>", "Text",
 CellID->688629],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"a_", ",", "b_", ",", "a_"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{", "c", "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "]"}], ",",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
