Cell["\<\
===================== nested CirclePlus (associativity) =========\
\>", "Text",
 CellID->867459932,ExpressionUUID->"2983d225-ac41-2d4a-9543-d97b96623c37"],

Cell["\<\
CirclePlus is associative: a \[CirclePlus] (b \[CirclePlus] c) flattens to a \
\[CirclePlus] b \[CirclePlus] c (order preserved,
since CirclePlus is not Orderless). Both directions canonicalize the nesting.\
\
\>", "Text",
 CellID->967039166,ExpressionUUID->"21e346e8-8674-a646-b6e5-90c2d64abdbd"],

Cell["\<\
21. Right-nested concat 'm a, m b, m c -> m (a + (b + c))' === flat 3-way.\
\>", "Text",
 CellID->668897788,ExpressionUUID->"5401b8e6-3b3f-c743-987b-0a934e60bd02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "2", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "4", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"z", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m_", ",", "a_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m_", ",", "b_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"a", "\[CirclePlus]", 
          RowBox[{"(", 
           RowBox[{"b", "\[CirclePlus]", "c"}], ")"}]}]}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->164713691,ExpressionUUID->"5604ee41-495e-7143-8d47-eebd6bdd7089"],

