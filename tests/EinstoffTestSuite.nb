         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
      RowBox[{"{",
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "]"}]], "VerificationTest",\

 CellID->973354780],

