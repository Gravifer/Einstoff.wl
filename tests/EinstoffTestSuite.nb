Cell["\<\
7. Two adjacent einx brackets flatten into one op axis ([b][c] == [b c]); \
flip
reverses the whole flattened block (cf. SPEC 7.3).\
\>", "Text",
 CellID->112266862],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"z", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a_", ",", "#b", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]",

      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "#b", ",", "#c"}], "}"}], "}"}]}], ",",
     RowBox[{"{", "z", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->418078876],

