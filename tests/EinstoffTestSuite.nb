Hold.\
\>", "Text",
 CellID->669677341],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"With", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"g", "=",
       RowBox[{
        RowBox[{
         RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{", "a", "}"}], "}"}]}], ",",
         RowBox[{"{", "x", "}"}], ",",
         RowBox[{"{", "}"}], ",",
         RowBox[{"TraceAction", "\[Rule]", "Hold"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"MatchQ", "[",
        RowBox[{"g", ",",
         RowBox[{"Hold", "[", "_ArrayReshape", "]"}]}], "]"}], ",",
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "_ArrayReduce"}], "]"}]}], ",",
       RowBox[{"FreeQ", "[",
        RowBox[{"g", ",", "_Einstoff`PackageScope`materializeOutput"}],
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->795843279],

