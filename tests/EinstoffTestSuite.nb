 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "===", 
     "ExternalSessionObject"}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"DeleteObject", "[", "Einstoff`Tests`$PySession", "]"}], "]"}]}],
    "]"}], ";"}]], "Input",
