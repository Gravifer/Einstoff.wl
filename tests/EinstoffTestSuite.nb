Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{
    RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"\"\<q\>\"", "\[CirclePlus]", "k_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
