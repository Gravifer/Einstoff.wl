         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
