Cell["\<\
12. A whole-axis blank `a_` is inference-only: binding it is rejected even \
when the
size agrees with the tensor. Block[{a}] keeps the bare `a` key unshadowed
so it reaches the axis rather than evaluating to a junk key.\
\>", "Text",
 CellID->244145597],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[",
  RowBox[{
   RowBox[{"{", "a", "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{"{", "a_", "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{", "a", "}"}], "}"}]}], ",",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"a", "\[Rule]", "3"}], "}"}]}], "]"}], ",",
     RowBox[{"{",
      StyleBox[
       RowBox[{"Einstoff", "::", "unsat"}], "MessageName"], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->277141062],

