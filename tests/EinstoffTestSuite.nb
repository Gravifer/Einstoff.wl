Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
  RowBox[{
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"p_", ",",
        RowBox[{"\"\<a\>\"", "\[CircleTimes]", "b_"}], ",", "x_"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"p_", ",", "c_", ",", "x_"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"n_", ",",
        RowBox[{"\"\<a\>\"", "\[CircleTimes]", "b_"}], ",", "x_"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"n_", ",", "c_", ",", "x_"}], "}"}]}], "}"}], "\[RuleDelayed]",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{
       RowBox[{"p", "\[CirclePlus]", "n"}], ",",
