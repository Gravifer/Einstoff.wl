Cell["\<\
13. An evaluated/junk binding key ({3 -> 2} from c = 3) WARNS but carries on: \
the
bracket axis c is sized from the tensor, the junk binding is dropped, and the
op succeeds.\
\>", "Text",
 CellID->885752861,ExpressionUUID->"b9948cb0-61ef-2b44-b4a5-c6769817dddd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", "3"}], "}"}], ",", 
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"a_", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",", 
        RowBox[{"{", "x", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", "\[Rule]", "2"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->149306119,ExpressionUUID->"0b46d875-83ca-5f44-b91c-88a15f6ea761"],

