       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"w", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"Take", "[", 
      RowBox[{"w", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "5"}], "}"}]}], "]"}], ",", 
     RowBox[{"Take", "[", 
      RowBox[{"w", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"6", ",", "10"}], "}"}]}], "]"}]}], "}"}]}], 
