Cell["\<\
16. A dropped size-1 (unit) axis is squeezed, not reduced: 'a 1 [b] -> a [b]' \
and the
{}/named-unit spellings all flip along b over the squeezed input (einx allows \
this).\
\>", "Text",
 CellID->379797411,ExpressionUUID->"3d1b31fc-8f20-c842-8d38-bf25fefff40f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"ref", "=", 
      RowBox[{"Reverse", "/@", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a_", ",", "1", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
       RowBox[{"{", "x", "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a_", ",", 
           RowBox[{"{", "}"}], ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
       RowBox[{"{", "x", "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a_", ",", "u_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
       RowBox[{"{", "x", "}"}]}], "]"}]}], "}"}]}], "]"}]], "VerificationTest",\

