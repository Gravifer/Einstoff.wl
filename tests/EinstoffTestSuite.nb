Cell["\<\
10. ...and a unit (size-1) literal operand axis squeezes: 'a 1, b -> a b' is \
the
(min-plus) outer product.\
\>", "Text",
 CellID->161420891],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"Range", "[", "4", "]"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
     RowBox[{"Plus", ",", "Min"}], "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"a_", ",", "1"}], "}"}], ",",
        RowBox[{"{", "b_", "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
