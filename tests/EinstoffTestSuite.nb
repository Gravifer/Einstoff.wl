        RowBox[{"{",
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"Range", "[", "4", "]"}]}]}], "}"}], ",",
   RowBox[{
