Cell["\<\
18. TraceAction holds the row-map lowering, not only the final materialized \
value.\
\>", "Text",
 CellID->645261128],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"With", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"g", "=",
       RowBox[{
        RowBox[{
         RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a", ",", "#b"}], "}"}], "}"}]}], ",",
         RowBox[{"{", "x", "}"}], ",",
         RowBox[{"{", "}"}], ",",
         RowBox[{"TraceAction", "\[Rule]", "Hold"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "_Map"}], "]"}]}], ",",
       RowBox[{"!",
        RowBox[{"FreeQ", "[",
         RowBox[{"g", ",", "Reverse"}], "]"}]}], ",",
       RowBox[{
        RowBox[{"ReleaseHold", "[", "g", "]"}], "===",
        RowBox[{
         RowBox[{
          RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
         RowBox[{
          RowBox[{
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a", ",", "#b"}], "}"}], "}"}]}], ",",
          RowBox[{"{", "x", "}"}]}], "]"}]}], ",",
       RowBox[{"FreeQ", "[",
        RowBox[{"g", ",", "_Einstoff`PackageScope`materializeOutput"}],
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->50799949],

