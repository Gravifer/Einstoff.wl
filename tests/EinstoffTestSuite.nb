 CellID->713836047,ExpressionUUID->"92199675-16c5-144a-9018-814096de25d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"lsm", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#1", "-", 
          RowBox[{"Max", "[", "#1", "]"}]}], ")"}], "-", 
        RowBox[{"Log", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"Exp", "[", 
           RowBox[{"#1", "-", 
            RowBox[{"Max", "[", "#1", "]"}]}], "]"}], "]"}], "]"}]}], 
       "&"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<log_softmax\>\"", 
      "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "x", "}"}]}], "]"}], "===", 
    RowBox[{"lsm", "/@", "x"}]}]}], "]"}]], "VerificationTest",
