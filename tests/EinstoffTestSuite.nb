Cell["Dot.wlt", "Section",
 CellID->261345525],

Cell["\<\
Cross-validation tests for the dot lowering: Einstoff[Dot] checked against \
the
actual einx.dot contraction (SPEC \[Section]10.1). Companion to the other
tests/python/*.wlt; see Reshape.wlt for the full rationale.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Integer inputs -> exact equality, no tolerance.

The session setup / pyDims helpers are intentionally duplicated from the \
other
python suites to keep each .wlt self-contained; factor into a shared harness
if this duplication grows.\
\>", "Text",
 CellID->455289920],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "r"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->167008799],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->138351353],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->869372348],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->291244815],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->197938223],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->989231813],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->954175781],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->891422507],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyKwargs", "[", "kw_Association", "]"}], ":=",
  RowBox[{"StringRiffle", "[",
   RowBox[{
    RowBox[{"KeyValueMap", "[",
     RowBox[{
      RowBox[{
       RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
        RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kw"}], "]"}],
    ",", "\"\<, \>\""}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->932045812],

Cell["\<\
pyDot[pattern, dims1, dims2, kwargs]: build both operands from their dims
recipes inside Python, apply einx.dot, return WL int lists. kwargs supply any
out-of-band axis sizes (e.g. a repetition axis). The einx pattern <-> the
Wolfram desc equivalence is reasoned out of band.\
\>", "Text",
 CellID->264445312],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDot", "[",
   RowBox[{"pattern_", ",", "dims1_List", ",", "dims2_List", ",",
    RowBox[{"kwargs_", ":",
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"kw", "=",
      RowBox[{"pyKwargs", "[", "kwargs", "]"}]}], "}"}], ",",
    RowBox[{"ExternalEvaluate", "[",
     RowBox[{"pySession", ",",
      RowBox[{"\"\<import numpy as np, einx\\n\>\"",
       "<>", "\"\<x = (1 + np.arange(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"Times", "@@", "dims1"}], "]"}], "<>", "\"\<)).reshape(\>\"",
       "<>",
       RowBox[{"pyDims", "[", "dims1", "]"}], "<>", "\"\<)\\n\>\"",
       "<>", "\"\<y = (1 + np.arange(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"Times", "@@", "dims2"}], "]"}], "<>", "\"\<)).reshape(\>\"",
       "<>",
       RowBox[{"pyDims", "[", "dims2", "]"}], "<>", "\"\<)\\n\>\"",
       "<>", "\"\<np.asarray(einx.dot(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x, y\>\"",
       "<>",
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
         RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}],
       "<>", "\"\<)).tolist()\>\""}]}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->6104215],

Cell["\<\
pyDotN[pattern, {dims0, dims1, \[Ellipsis]}]: build N operands x0,x1,\
\[Ellipsis] from their dims
recipes inside Python and apply einx.dot.\
\>", "Text",
 CellID->286398829],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDotN", "[",
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"setup", ",", "args"}], "}"}], ",",
    RowBox[{
     RowBox[{"setup", "=",
      RowBox[{"StringJoin", "[",
       RowBox[{"MapIndexed", "[",
        RowBox[{
         RowBox[{
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"nm", "=",
               RowBox[{"\"\<x\>\"", "<>",
                RowBox[{"ToString", "[",
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",",
              RowBox[{"d", "=", "#1"}]}], "}"}], ",",
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>",
             RowBox[{"ToString", "[",
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>",
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}],
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";",
     RowBox[{"args", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"Table", "[",
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>",
           RowBox[{"ToString", "[", "i", "]"}]}], ",",
          RowBox[{"{",
           RowBox[{"i", ",", "0", ",",
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup",
        "<>", "\"\<np.asarray(einx.dot(\>\"", "<>",
        RowBox[{"ToString", "[",
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",\

 InitializationCell->True,
 CellID->166480059],

