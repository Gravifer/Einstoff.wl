     RowBox[{"Flatten", "[",
      RowBox[{
       RowBox[{"N", "[", "u", "]"}], "-", "v"}], "]"}], "]"}], "]"}], "<",
   "1.`*^-9"}]}]], "Input",
 InitializationCell->True,
 CellID->98589363],

