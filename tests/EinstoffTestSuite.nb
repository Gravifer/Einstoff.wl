       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"a_", ",", "b_"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
