Cell["Map.wlt", "Section",
 CellID->577777461,ExpressionUUID->"93d699b2-07cc-9e44-ab30-14a9b358c63a"],

Cell["\<\
Cross-validation for Einstoff[Map] against einx's miscellaneous ops
(https://einx.readthedocs.io/en/stable/api/operations/misc.html): flip, sort,
roll and softmax along a bracketed axis (\"a [b]\").  Integer ops are \
compared
exactly; softmax is float, compared within a tolerance.  NB \
einx.roll(shift=k)
shifts toward higher indices, i.e. it is RotateRight[#, k] (verified vs numpy).

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Session setup duplicated from the other python suites (self-contained).\
\>", "Text",
 CellID->555440979,ExpressionUUID->"b5de805f-065e-bd46-ac90-93dfcb69be39"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->770739749,ExpressionUUID->"61213085-4cf5-e741-8e8d-fc2378e1c55f"],

Cell[BoxData[
 RowBox[{"pyRoot", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",", 
    "Einstoff`Tests`$Root", ",", 
    RowBox[{"ParentDirectory", "[", 
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}], 
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->22230399,ExpressionUUID->"73d68060-57b0-3643-b0a1-804bd7164a92"],

Cell[BoxData[
 RowBox[{"pyExe", "=", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"", 
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->646212527,ExpressionUUID->"ea54cc58-61d3-9b4f-b514-8795b91a3e3a"],

Cell[BoxData[
 RowBox[{"pyOwned", "=", 
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=", 
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->155106689,ExpressionUUID->"307e0a00-5b8b-3741-86fc-de4c32ac30e3"],

Cell[BoxData[
 RowBox[{"pySession", "=", 
  RowBox[{"If", "[", 
   RowBox[{"pyOwned", ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",", 
         RowBox[{"StartExternalSession", "[", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}], 
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->526042069,ExpressionUUID->"3e08bab9-f40e-2344-85b5-fd8fa6660b10"],

Cell[BoxData[
 RowBox[{"pythonReady", "=", 
  RowBox[{"TrueQ", "[", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===", 
        "ExternalSessionObject"}], "&&", 
       RowBox[{
        RowBox[{"ExternalEvaluate", "[", 
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}], 
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->571405820,ExpressionUUID->"1c41fee9-afd5-584b-ba95-841741df6c31"],

Cell["\<\
Run einx `call` (a Python expression in x) on the array built by `pyInput`
(a Python expression), returning the result as a nested list.\
\>", "Text",
 CellID->27993251,ExpressionUUID->"4a697262-1efe-5448-8c8a-9be1fa7c4b2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyMap", "[", 
   RowBox[{"call_String", ",", "pyInput_String"}], "]"}], ":=", 
  RowBox[{"ExternalEvaluate", "[", 
   RowBox[{"pySession", ",", 
    RowBox[{"\"\<import numpy as np, einx\\nx = \>\"", "<>", "pyInput", 
     "<>", "\"\<\\nnp.asarray(\>\"", "<>", "call", 
     "<>", "\"\<).tolist()\>\""}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->497645811,ExpressionUUID->"ebd99b77-a7b8-7546-9b77-d19a36972b9c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"approxEqual", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"N", "[", "u", "]"}], "-", "v"}], "]"}], "]"}], "]"}], "<", 
   "1.`*^-9"}]}]], "Input",
 InitializationCell->True,
 CellID->209082015,ExpressionUUID->"140e7b29-60e5-5f4e-a87d-d584697c41b7"],

