      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
