Cell["einops 'a b c -> c a b'  <->  {{a_,b_,c_}} :> {{c,a,b}}", "Text",
 CellID->80768597],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[",
  RowBox[{
   RowBox[{
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "}"}], "\[RuleDelayed]",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"c", ",", "a", ",", "b"}], "}"}], "}"}]}], ",",
   RowBox[{"{",
