         RowBox[{"Range", "[", "8", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",",
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",",
   RowBox[{"{",
    StyleBox[
     RowBox[{"Einstoff", "::", "unsupp"}], "MessageName"], "}"}]}],
  "]"}]], "VerificationTest",
 CellID->661784669],

