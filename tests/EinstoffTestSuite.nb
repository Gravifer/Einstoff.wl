        RowBox[{"{",
         RowBox[{"m", ",", "b"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "14", "]"}], ",",
