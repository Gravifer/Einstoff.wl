Cell["\<\
26m. Raw EinstoffMatch accepts a bracket binding key #a = Slot[\"a\"] \
(consistent with
the scoped path, which canonicalizes it); previously only bare-symbol/string \
keys were
accepted, so a bracket key was wrongly rejected by the _Symbol key gate.\
\>", "Text",
 CellID->490112708],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Einstoff`EinstoffMatch", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"{",
     RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], "}"}], "}"}], ",",

   RowBox[{"{",
    RowBox[{"{", "6", "}"}], "}"}], ",",
   RowBox[{"{",
    RowBox[{"#a", "\[Rule]", "2"}], "}"}]}], "]"}]], "VerificationTest",
 CellID->388320843],

Cell[BoxData[
 RowBox[{"Association", "[",
