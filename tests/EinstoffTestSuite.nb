        RowBox[{"{", 
         RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], "\[LeftDoubleBracket]", "i", 
    "\[RightDoubleBracket]"}], ",", 
   RowBox[{"{", 
