 CellID->976169483,ExpressionUUID->"0841c682-e629-ff4f-90e7-2af7f8e04f6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}], "}"}]}], ",", 
     RowBox[{"v", "=", 
      RowBox[{"{", 
       RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}]}]}], "}"}], 
   ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "\"\<logsumexp\>\"", 
     "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", "a", "}"}], "}"}]}], ",", 
     RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->656862914,ExpressionUUID->"3fec99fa-f98b-d74b-ba0f-422e1c3f5a46"],

Cell[BoxData[
 RowBox[{"{", 
