Cell["\<\
16. Reduce all axes, then broadcast the scalar into a vector: '[a] [b] -> c'.\
\
\>", "Text",
 CellID->108079978,ExpressionUUID->"ec29f578-3f85-d34e-a85d-e21b9048ff95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"#a", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", "c", "}"}], "}"}]}], ",", 
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", "\[Rule]", "3"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->436275569,ExpressionUUID->"e5c3b1ac-8925-f04b-a57b-d9c91e19fde6"],

