   RowBox[{"Max", "[", 
    RowBox[{"{", 
     RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}], "]"}], "+", 
   RowBox[{"Log", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}], "-", 
       RowBox[{"Max", "[", 
        RowBox[{"{", 
         RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}], "]"}]}], 
