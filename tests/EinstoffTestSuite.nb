Cell["\<\
14. A Pattern-form binding key `r_ -> n` is a category error (a matcher, not \
an axis
name) \[LongDash] rejected, not silently ignored (which would let a \
whole-axis binder be
\"bound\" and still succeed by tensor inference).\
\>", "Text",
 CellID->720009471,ExpressionUUID->"7e60e9f5-0f51-744b-b490-aef3cd2a6764"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", "r", "}"}], ",", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "r_", "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", "r", "}"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
