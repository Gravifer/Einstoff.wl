Cell[CellGroupData[{

Cell["python", "Chapter",
 CellID->218828139],

Cell[CellGroupData[{

Cell["DirectSum.wlt", "Section",
 CellID->260424722],

Cell["\<\
Cross-validation tests for the direct-sum lowering: Einstoff[\"Massage\"],
Einstoff[Join] and Einstoff[Split] checked against the actual einx.id `+`
(SPEC \[Section]10.1). Companion to the other tests/python/*.wlt; see \
Reshape.wlt for
the full rationale.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Integer inputs -> exact equality, no tolerance.

einx matches direct-sum summands positionally; the einx pattern <-> Wolfram \
desc
equivalence is reasoned out of band.\
\>", "Text",
 CellID->121117204],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "m"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->469629016],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->617545277],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->818906519],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->416651790],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->463863991],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->965626654],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->19701741],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->431023403],

Cell["\<\
pyConcat[pattern, {dimsList...}, kwargs]: build each operand from its dims \
recipe
inside Python (x0, x1, \[Ellipsis]), apply einx.id with any out-of-band axis \
sizes, return
WL int lists. A dims of {} builds a 0-d scalar operand.\
\>", "Text",
 CellID->306777616],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyConcat", "[",
   RowBox[{"pattern_", ",", "dimsList_List", ",",
    RowBox[{"kwargs_", ":",
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"setup", ",", "args", ",", "kw"}], "}"}], ",",
    RowBox[{
     RowBox[{"setup", "=",
      RowBox[{"StringJoin", "[",
       RowBox[{"MapIndexed", "[",
        RowBox[{
         RowBox[{
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"nm", "=",
               RowBox[{"\"\<x\>\"", "<>",
                RowBox[{"ToString", "[",
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",",
              RowBox[{"d", "=", "#1"}]}], "}"}], ",",
            RowBox[{"If", "[",
             RowBox[{
              RowBox[{"d", "===",
               RowBox[{"{", "}"}]}], ",",
              RowBox[{"nm", "<>", "\"\< = np.asarray(42)\\n\>\""}], ",",
              RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>",
               RowBox[{"ToString", "[",
                RowBox[{"Times", "@@", "d"}], "]"}],
               "<>", "\"\<)).reshape(\>\"", "<>",
               RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}],
             "]"}]}], "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";",
     RowBox[{"args", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"Table", "[",
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>",
           RowBox[{"ToString", "[", "i", "]"}]}], ",",
          RowBox[{"{",
           RowBox[{"i", ",", "0", ",",
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"kw", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"KeyValueMap", "[",
         RowBox[{
          RowBox[{
           RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
            RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kwargs"}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup",
        "<>", "\"\<np.asarray(einx.id(\>\"", "<>",
        RowBox[{"ToString", "[",
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>",
        RowBox[{"If", "[",
         RowBox[{
          RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
          RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}],
        "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->864192003],

Cell["\<\
pySplit[pattern, dims, kwargs]: build one operand from `dims`, apply the \
einx.id
split, and return the tuple of output arrays as a WL list of int lists.\
\>", "Text",
 CellID->472041374],

Cell[BoxData[
 RowBox[{
  RowBox[{"pySplit", "[",
   RowBox[{"pattern_", ",", "dims_List", ",", "kwargs_Association"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"kw", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"KeyValueMap", "[",
         RowBox[{
          RowBox[{
           RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
            RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kwargs"}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], "}"}], ",",
    RowBox[{"ExternalEvaluate", "[",
     RowBox[{"pySession", ",",
      RowBox[{"\"\<import numpy as np, einx\\n\>\"",
       "<>", "\"\<x = (1 + np.arange(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"Times", "@@", "dims"}], "]"}], "<>", "\"\<)).reshape(\>\"", "<>",
       RowBox[{"pyDims", "[", "dims", "]"}], "<>", "\"\<)\\n\>\"",
       "<>", "\"\<[np.asarray(o).tolist() for o in einx.id(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x\>\"", "<>",
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
