Cell["\<\
12. A whole-axis binder `a_` is inference-only: binding it is rejected even \
when the
size agrees with the tensor (a composite split-factor binder, by contrast, IS
bindable \[LongDash] see ex2 in Parsing.wlt).  Block[{a}] keeps the bare `a` \
key unshadowed
so it reaches the axis rather than evaluating to a junk key.\
\>", "Text",
 CellID->944715886,ExpressionUUID->"5142a191-9894-b54b-9961-7a2d818af2f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "a_", "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", "a", "}"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", "\[Rule]", "3"}], "}"}]}], "]"}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->947110952,ExpressionUUID->"3a7ea5f5-6dcd-8f4b-bb4a-8dff368f36b1"],

