     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"p_", "\[CirclePlus]", "q_", "\[CirclePlus]", "r_"}]}],
        "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"b", ",", "p"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "q"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "r"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "z", "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"p", "\[Rule]", "2"}], ",",
       RowBox[{"q", "\[Rule]", "3"}]}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->523453968],

