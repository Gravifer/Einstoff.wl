         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->644833398],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->805442186],

Cell["\<\
einops.einsum with tensors then the pattern; inputs 1+arange reshaped, like \
WL Range.\
\>", "Text",
 CellID->372246517],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyEinsum", "[",
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"setup", ",", "args"}], "}"}], ",",
    RowBox[{
     RowBox[{"setup", "=",
      RowBox[{"StringJoin", "[",
       RowBox[{"MapIndexed", "[",
        RowBox[{
         RowBox[{
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"nm", "=",
               RowBox[{"\"\<x\>\"", "<>",
                RowBox[{"ToString", "[",
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",",
              RowBox[{"d", "=", "#1"}]}], "}"}], ",",
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>",
             RowBox[{"ToString", "[",
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>",
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}],
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";",
     RowBox[{"args", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"Table", "[",
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>",
           RowBox[{"ToString", "[", "i", "]"}]}], ",",
          RowBox[{"{",
           RowBox[{"i", ",", "0", ",",
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einops\\n\>\"", "<>", "setup",
        "<>", "\"\<np.asarray(einops.einsum(\>\"", "<>", "args",
        "<>", "\"\<, \>\"", "<>",
        RowBox[{"ToString", "[",
         RowBox[{"pattern", ",", "InputForm"}], "]"}],
        "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->553762163],

