     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"a_", ",", "a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "16", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2", ",", "4"}], "}"}]}], "]"}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->780903680],

