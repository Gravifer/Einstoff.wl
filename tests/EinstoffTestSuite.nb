Cell["4. id (einx.id) is the identity along the bracket.", "Text",
 CellID->578885395],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<id\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
