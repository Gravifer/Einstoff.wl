         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
      RowBox[{"{",
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "]"}]], "VerificationTest",\

 CellID->243896551],

