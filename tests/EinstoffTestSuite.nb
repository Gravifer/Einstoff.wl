       RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"2", ",", "3", ",", "2", ",", "5"}], "}"}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
