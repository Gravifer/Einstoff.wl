Cell["\<\
20b. A name repeated within the input shape ('b' as a carried axis) is \
within-tensor
contraction, which the split path cannot do \[LongDash] rejected by its own \
guard.  Each output
{{b, q}, {b, k}} is duplicate-free, so EinstoffShapes is Satisfiable and the \
rejection
is the split guard's alone (without it the desc reaches lowering and \
mis-slices \[LongDash]
verified, so this test isolates the guard).  (A repeated direct-sum *summand* \
q (+) q
is a distinct, deferred equal-split case; here the repeat is a carried axis.)\
\
\>", "Text",
 CellID->153330344],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "Split", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"b_", ",", "b_", ",",
        RowBox[{"q_", "\[CirclePlus]", "k_"}]}], "}"}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"b", ",", "q"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2", ",", "5"}], "}"}]}], "]"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"\"\<q\>\"", "\[Rule]", "2"}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->764747427],

Cell[BoxData["$Failed"], "ExpectedOutput",
 CellID->561276472],

