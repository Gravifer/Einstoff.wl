  RowBox[{
   RowBox[{"{", 
    RowBox[{"c", "=", "3"}], "}"}], ",", 
   RowBox[{"Sort", "[", 
    RowBox[{"SymbolName", "/@", 
     RowBox[{"Keys", "[", 
      RowBox[{
       RowBox[{"Einstoff`EinstoffShapes", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"a_", ",", "c_"}], "}"}], "}"}], "\[RuleDelayed]", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"c", ",", "a"}], "}"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}], 
       "[", "\"\<Bindings\>\"", "]"}], "]"}]}], "]"}]}], 
