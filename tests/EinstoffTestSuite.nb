Cell["DirectSum.wlt", "Section",
 CellID->523991006,ExpressionUUID->"9ff7506d-b164-7041-a49d-b3679f686164"],

Cell["\<\
Tests for the direct-sum lowering path (CirclePlus concat; Einstoff[Join] and
the CirclePlus branch of Einstoff[\"Massage\"]).
One file per lowering path under tests/; cf. Reshape.wlt.
Run via: wolframscript -script scripts/run-tests.wls
BeginTestSection/EndTestSection are MUnit markers; the runner loads MUnit`
so they carry section semantics. The .wlt itself does not import MUnit`.\
\>", "Text",
 CellID->239730268,ExpressionUUID->"1a3a3157-06e4-6c4b-bec8-92d0d508cd28"],

Cell["Einstoff`Lowering`DirectSum", "Subsection",
 CellID->701514599,ExpressionUUID->"625679b6-e195-5848-beb6-2f996955fb49"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{
  "a", ",", "b", ",", "c", ",", "k", ",", "m", ",", "p", ",", "q", ",", "r"}],
   "]"}]], "Input",
 InitializationCell->True,
 CellID->731641596,ExpressionUUID->"1c723e61-4c51-714c-840f-8d424ba56a15"],

Cell["\<\
===================== concatenation (einx `+` on RHS) =============\
\>", "Text",
 CellID->270853414,ExpressionUUID->"db6bf2aa-8748-1743-8875-8fd6ebfdf8f9"],

Cell["\<\
1. Scalar append 'b c, -> b (c + 1)' with scalar 42 (SPEC ex4)
=== native Join of x and a constant column.\
\>", "Text",
 CellID->820642229,ExpressionUUID->"b1a57832-8841-b64a-9a12-30b55a91255d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "15", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b_", ",", "c_"}], "}"}], ",", 
        RowBox[{"{", "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"c", "\[CirclePlus]", "1"}]}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "42"}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->734434623,ExpressionUUID->"9f710d5c-e71f-b548-ab55-f375cb019e2e"],

Cell[BoxData[
 RowBox[{"Join", "[", 
