   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"2", ",", "3", ",", "2", ",", "5"}], "}"}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->323085105],

