     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->118627985],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
