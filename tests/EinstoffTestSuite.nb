     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"m_", ",", "a_", ",", "a_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"m_", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"m", ",",
         RowBox[{"a", "\[CirclePlus]", "b"}]}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",",
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",",
   RowBox[{"{",
    StyleBox[
     RowBox[{"Einstoff", "::", "unsupp"}], "MessageName"], "}"}]}],
  "]"}]], "VerificationTest",
 CellID->189499762],

