Cell["\<\
pySplit[pattern, dims, kwargs]: build one operand from `dims`, apply the \
einx.id
split, and return the tuple of output arrays as a WL list of int lists.\
\>", "Text",
 CellID->843258316],

Cell[BoxData[
 RowBox[{
  RowBox[{"pySplit", "[",
   RowBox[{"pattern_", ",", "dims_List", ",", "kwargs_Association"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"kw", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"KeyValueMap", "[",
         RowBox[{
          RowBox[{
           RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
            RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kwargs"}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], "}"}], ",",
    RowBox[{"ExternalEvaluate", "[",
     RowBox[{"pySession", ",",
      RowBox[{"\"\<import numpy as np, einx\\n\>\"",
       "<>", "\"\<x = (1 + np.arange(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"Times", "@@", "dims"}], "]"}], "<>", "\"\<)).reshape(\>\"", "<>",
       RowBox[{"pyDims", "[", "dims", "]"}], "<>", "\"\<)\\n\>\"",
       "<>", "\"\<[np.asarray(o).tolist() for o in einx.id(\>\"", "<>",
       RowBox[{"ToString", "[",
        RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x\>\"", "<>",
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
         RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)]\>\""}]}],
     "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->47992267],

