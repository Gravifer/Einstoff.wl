\>", "Text",
 CellID->740193934],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"w", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"m_", ",",
         RowBox[{"a_", "\[CirclePlus]", "b_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"m", ",", "a"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"m", ",", "b"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "w", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->77951182],

Cell[BoxData[
 RowBox[{"With", "[",
