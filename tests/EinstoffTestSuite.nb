       RowBox[{"{",
        RowBox[{"b_", ",", "c_"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"b_", ",", "k_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
