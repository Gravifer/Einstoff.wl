Cell["\<\
6. A pure permute (no contraction) is allowed \[LongDash] ArrayContract \
\[SupersetEqual] ArrayReshape.\
\>", "Text",
 CellID->322601052,ExpressionUUID->"7fabb1d3-da7f-da4c-b698-12a8e3791ca3"],

Cell[CellGroupData[{

Cell[BoxData[
