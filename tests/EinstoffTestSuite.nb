Cell[CellGroupData[{

Cell["Einsum.wlt", "Section",
 CellID->167498489],

Cell["\<\
Cross-validation for Einstoff[\"einsum\"] against einops.einsum (which wraps \
the
backend np.einsum).  Covers within-tensor contraction (partial trace, full \
trace)
and cross-tensor contraction (matmul) \[LongDash] the pairwise-contraction \
subset.  einops
uses space-separated axis names: \"a b a d -> b d\".

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Session setup duplicated from the other python suites (self-contained).\
\>", "Text",
 CellID->878854753],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->988608126],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->494136786],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->489096145],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->338420547],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->679247790],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{"pySession", ",", "\"\<import numpy, einops; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->831492682],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->136858594],

Cell["\<\
einops.einsum with tensors then the pattern; inputs 1+arange reshaped, like \
WL Range.\
\>", "Text",
 CellID->51107097],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyEinsum", "[",
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"setup", ",", "args"}], "}"}], ",",
    RowBox[{
     RowBox[{"setup", "=",
      RowBox[{"StringJoin", "[",
       RowBox[{"MapIndexed", "[",
        RowBox[{
         RowBox[{
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"nm", "=",
               RowBox[{"\"\<x\>\"", "<>",
                RowBox[{"ToString", "[",
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",",
              RowBox[{"d", "=", "#1"}]}], "}"}], ",",
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>",
             RowBox[{"ToString", "[",
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>",
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}],
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";",
     RowBox[{"args", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"Table", "[",
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>",
           RowBox[{"ToString", "[", "i", "]"}]}], ",",
          RowBox[{"{",
           RowBox[{"i", ",", "0", ",",
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einops\\n\>\"", "<>", "setup",
        "<>", "\"\<np.asarray(einops.einsum(\>\"", "<>", "args",
        "<>", "\"\<, \>\"", "<>",
        RowBox[{"ToString", "[",
         RowBox[{"pattern", ",", "InputForm"}], "]"}],
        "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->987987283],

