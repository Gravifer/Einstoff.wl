        RowBox[{"{", "b_", "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
     RowBox[{"{",
