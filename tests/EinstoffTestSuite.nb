Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
      RowBox[{"Times", ",", "Plus"}], "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"a_", ",", "b_"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
      RowBox[{"{",
