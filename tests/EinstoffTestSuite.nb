Cell["\<\
16. An axis name inside a targeted composite (Slot[(c d)]) is canonicalized \
like any
grammar position: under a shadowing Block it still resolves, matching the
unshadowed result.  The supplied factor is string-spelled; c_ remains \
inferred.\
\>", "Text",
 CellID->278843087],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "18", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Block", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"c", "=", "3"}], "}"}], ",",
