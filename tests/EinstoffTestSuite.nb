Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"With", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"g", "=",
       RowBox[{
        RowBox[{"Einstoff", "[", "Split", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"b_", ",",
             RowBox[{"q", "\[CirclePlus]", "k"}]}], "}"}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{
            RowBox[{"{",
             RowBox[{"b", ",", "q"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
         RowBox[{"{", "x", "}"}], ",",
         RowBox[{"{",
          RowBox[{
           RowBox[{"q", "\[Rule]", "3"}], ",",
           RowBox[{"k", "\[Rule]", "2"}]}], "}"}], ",",
         RowBox[{"TraceAction", "\[Rule]", "Hold"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"Length", "[",
        RowBox[{"Cases", "[",
         RowBox[{"g", ",", "_Take", ",", "\[Infinity]"}], "]"}], "]"}], ",",
       RowBox[{"ReleaseHold", "[", "g", "]"}], ",",
       RowBox[{"FreeQ", "[",
        RowBox[{"g", ",", "_Einstoff`PackageScope`materializeOutput"}],
        "]"}]}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->446921531],

