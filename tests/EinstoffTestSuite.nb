Cell["\<\
8. Softmax (einx.softmax) along the bracket, vs the stable max-shift form.\
\>", "Text",
 CellID->630909585,ExpressionUUID->"044e3a0c-1702-d944-a6c6-1e26fe216eb2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"sm", "=", 
      RowBox[{
       FractionBox[
        RowBox[{"Exp", "[", 
         RowBox[{"#1", "-", 
          RowBox[{"Max", "[", "#1", "]"}]}], "]"}], 
        RowBox[{"Total", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{"#1", "-", 
           RowBox[{"Max", "[", "#1", "]"}]}], "]"}], "]"}]], "&"}]}]}], "}"}],
    ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<softmax\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "x", "}"}]}], "]"}], "===", 
    RowBox[{"sm", "/@", "x"}]}]}], "]"}]], "VerificationTest",
 CellID->173525930,ExpressionUUID->"ab13786d-b854-e24a-b923-d2d158ac325f"],

