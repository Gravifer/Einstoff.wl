Cell["\<\
18. A globally bound integer that disagrees with the tensor is rejected.\
\>", "Text",
 CellID->558242807],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"k", "=", "5"}], "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{"With", "[",
      RowBox[{
       RowBox[{"{",
        RowBox[{"x", "=",
         RowBox[{"ArrayReshape", "[",
          RowBox[{
           RowBox[{"Range", "[", "12", "]"}], ",",
           RowBox[{"{",
            RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
       RowBox[{
        RowBox[{
         RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a_", ",", "k"}], "}"}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{", "a", "}"}], "}"}]}], ",",
         RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}], ",",
     RowBox[{"{",
      StyleBox[
       RowBox[{"Einstoff", "::", "unsat"}], "MessageName"], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->585914616],

