Cell["DirectSum.wlt", "Section",
 CellID->290087222,ExpressionUUID->"5c15257c-d2fc-a54e-a6f5-710af2803f45"],

Cell["\<\
Cross-validation tests for the direct-sum concat lowering: Einstoff[\"Massage\
\"]
/ Einstoff[Join] checked against the actual einx.id `+` (SPEC \
\[Section]10.1). Companion
to the other tests/python/*.wlt; see Reshape.wlt for the full rationale.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Integer inputs -> exact equality, no tolerance.

einx concatenates along a direct-sum axis positionally (summand i <- operand \
i);
the einx pattern <-> Wolfram desc equivalence is reasoned out of band.\
\>", "Text",
 CellID->81967047,ExpressionUUID->"102d2717-0f45-ff4d-a231-d803f1716b45"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "m"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->333977930,ExpressionUUID->"01cdf2fd-4330-a540-b10c-a49feb344092"],

Cell[BoxData[
 RowBox[{"pyRoot", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",", 
    "Einstoff`Tests`$Root", ",", 
    RowBox[{"ParentDirectory", "[", 
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}], 
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->557836920,ExpressionUUID->"04cef919-c8cc-4849-8ed9-52c36de3e5d8"],

Cell[BoxData[
 RowBox[{"pyExe", "=", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"", 
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->614128482,ExpressionUUID->"36c2e883-9aed-9149-8ac3-056d1239c34f"],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->501604126,ExpressionUUID->"17dea4e4-0e97-5e4f-8d63-0fb06379b260"],

Cell[BoxData[
 RowBox[{"pyOwned", "=", 
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=", 
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->118616088,ExpressionUUID->"8ab60246-df50-6d48-b9f4-1157bbb1cd43"],

Cell[BoxData[
 RowBox[{"pySession", "=", 
  RowBox[{"If", "[", 
   RowBox[{"pyOwned", ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",", 
         RowBox[{"StartExternalSession", "[", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}], 
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->245981361,ExpressionUUID->"c43a934d-dae8-9d43-ac0d-3343b941a1fd"],

Cell[BoxData[
 RowBox[{"pythonReady", "=", 
  RowBox[{"TrueQ", "[", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===", 
        "ExternalSessionObject"}], "&&", 
       RowBox[{
        RowBox[{"ExternalEvaluate", "[", 
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}], 
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->975620744,ExpressionUUID->"d833ec70-4711-064f-bb61-71474fafb9cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=", 
  RowBox[{"\"\<[\>\"", "<>", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}], 
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->98754867,ExpressionUUID->"bf513011-4bc0-f04e-a3c1-6b93a164b9af"],

Cell["\<\
pyConcat[pattern, {dimsList...}, kwargs]: build each operand from its dims \
recipe
inside Python (x0, x1, \[Ellipsis]), apply einx.id with any out-of-band axis \
sizes, return
WL int lists. A dims of {} builds a 0-d scalar operand.\
\>", "Text",
 CellID->39518670,ExpressionUUID->"8659f352-50a6-a841-bfbd-85ce4bd1cbb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyConcat", "[", 
   RowBox[{"pattern_", ",", "dimsList_List", ",", 
    RowBox[{"kwargs_", ":", 
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setup", ",", "args", ",", "kw"}], "}"}], ",", 
    RowBox[{
     RowBox[{"setup", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nm", "=", 
               RowBox[{"\"\<x\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",", 
              RowBox[{"d", "=", "#1"}]}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"d", "===", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"nm", "<>", "\"\< = np.asarray(42)\\n\>\""}], ",", 
              RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"Times", "@@", "d"}], "]"}], 
               "<>", "\"\<)).reshape(\>\"", "<>", 
               RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}], 
             "]"}]}], "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";", 
     RowBox[{"args", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";", 
     RowBox[{"kw", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "<>", "\"\<=\>\"", "<>", 
            RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kwargs"}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"pySession", ",", 
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup", 
        "<>", "\"\<np.asarray(einx.id(\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",", 
          RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], 
        "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->111431767,ExpressionUUID->"3d58fa76-6c2b-1b49-9bb6-7c7868445287"],

Cell["\<\
pySplit[pattern, dims, kwargs]: build one operand from `dims`, apply the \
einx.id
split, and return the tuple of output arrays as a WL list of int lists.\
\>", "Text",
 CellID->452081206,ExpressionUUID->"9135e40e-2729-ce47-a8f5-f269df9f5eda"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pySplit", "[", 
   RowBox[{"pattern_", ",", "dims_List", ",", "kwargs_Association"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kw", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "<>", "\"\<=\>\"", "<>", 
            RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kwargs"}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], "}"}], ",", 
    RowBox[{"ExternalEvaluate", "[", 
     RowBox[{"pySession", ",", 
      RowBox[{"\"\<import numpy as np, einx\\n\>\"", 
       "<>", "\"\<x = (1 + np.arange(\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Times", "@@", "dims"}], "]"}], "<>", "\"\<)).reshape(\>\"", "<>", 
       RowBox[{"pyDims", "[", "dims", "]"}], "<>", "\"\<)\\n\>\"", 
       "<>", "\"\<[np.asarray(o).tolist() for o in einx.id(\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x\>\"", "<>", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",", 
         RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)]\>\""}]}], 
     "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->532317752,ExpressionUUID->"c8592876-5b0d-bf42-8624-0b80f68898c7"],

Cell["\<\
========================================================================\
\>", "Text",
 CellID->479394507,ExpressionUUID->"22b86820-85f8-6e4c-8164-c1f86b94b1a8"],

