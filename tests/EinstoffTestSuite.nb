  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Dimensions", "[", 
