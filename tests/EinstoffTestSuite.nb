Cell["5. ...and agrees with Einstoff[Dot] on the same desc.", "Text",
 CellID->568488324],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<einsum\>\"", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"a_", ",", "b_"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
      RowBox[{"{",
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "===",
    RowBox[{
     RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"a_", ",", "b_"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
      RowBox[{"{",
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "]"}]], "VerificationTest",\

 CellID->553562795],

