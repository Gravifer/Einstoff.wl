Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",

    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
