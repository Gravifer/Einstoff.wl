     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a", ",", "2"}], "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", 
