Cell["\<\
Tear down only a session we spawned ourselves; the runner owns the shared one.\
\>", "Text",
 CellID->605376704,ExpressionUUID->"07127402-9660-3642-804d-2db2a49ee3af"],

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"pyOwned", "&&", 
    RowBox[{
     RowBox[{"Head", "[", "pySession", "]"}], "===", 
     "ExternalSessionObject"}]}], ",", 
   RowBox[{"Quiet", "[", 
    RowBox[{"DeleteObject", "[", "pySession", "]"}], "]"}]}], "]"}]], "Input",\

 InitializationCell->True,
 CellID->349696168,ExpressionUUID->"aac07d23-c525-9a4f-be75-40fc9520ad52"],

Cell["Teardown", "Chapter",
