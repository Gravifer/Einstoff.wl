Cell["\<\
15e. A bare binding key that evaluated to a System` symbol (e.g. {c->2} under \
c=Null
arrives as {Null->2}) is an evaluated shadow-capture, not a bare axis \
\"Null\": it
is dropped as junk (bracket #c is sized from the tensor), so no Null survives \
as a
resolved-bindings KEY.  (Check via Keys \[LongDash] FreeQ does not inspect \
Association keys.)\
\>", "Text",
 CellID->686608774,ExpressionUUID->"d7949ce5-f386-4f4a-ac8b-b6c238af1c5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c", "=", "Null"}], "}"}], ",", 
   RowBox[{"Sort", "[", 
    RowBox[{"SymbolName", "/@", 
     RowBox[{"Keys", "[", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"Einstoff`EinstoffShapes", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"a_", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", "\[Rule]", "2"}], "}"}]}], "]"}], 
        "[", "\"\<Bindings\>\"", "]"}], "]"}], "]"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->750613411,ExpressionUUID->"a3e9c4b4-6fa8-9044-ab67-85fc240646a7"],

