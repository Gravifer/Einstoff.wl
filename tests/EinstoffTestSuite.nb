Cell["\<\
15. Reduce b, then broadcast into a new axis c: 'a [b] -> a c', c=3.\
\>", "Text",
 CellID->428999363,ExpressionUUID->"28bd38b5-d776-d34f-809d-5189b7d38f6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",", 
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", "\[Rule]", "3"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->716701611,ExpressionUUID->"340bf36a-26b2-8c46-b287-1d6f963c7c2b"],

