Cell["\<\
22. A unit (size-1) literal operand axis is squeezed, so 'a 1, b -> a b' (== \
einx
'a (), b') is an outer product \[LongDash] the {} spelling behaves \
identically.\
\>", "Text",
 CellID->340005388,ExpressionUUID->"eae89990-46ac-a249-b0f5-9110f36a3d2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"Range", "[", "4", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
