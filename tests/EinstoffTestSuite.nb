Cell["\<\
23. Nested split 'b (q + (a + k)) -> b q, b a, b k', q=2, a=3 === flat 3-way.\
\
\>", "Text",
 CellID->520244545,ExpressionUUID->"bf699047-37e7-5a45-a646-9f2f5c189c54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"b_", ",", 
         RowBox[{"\"\<q\>\"", "\[CirclePlus]", 
          RowBox[{"(", 
           RowBox[{"\"\<a\>\"", "\[CirclePlus]", "k_"}], ")"}]}]}], "}"}], 
       "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b", ",", "\"\<q\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "\"\<a\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", "w", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<q\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<a\>\"", "\[Rule]", "3"}]}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->757273104,ExpressionUUID->"3c99277c-f550-4642-8bc1-d59f61a41857"],

Cell[BoxData[
 RowBox[{"With", "[", 
