 RowBox[{
  RowBox[{"Quiet", "[",
   RowBox[{"Einstoff`EinstoffShapes", "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{", "\"\<a b\>\"", "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{", "\"\<a b\>\"", "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"{", "3", "}"}], "}"}]}], "]"}], "]"}], ";",
  RowBox[{"StringContainsQ", "[",
   RowBox[{
    RowBox[{
