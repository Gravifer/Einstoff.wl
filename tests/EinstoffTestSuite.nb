Cell["\<\
25. A scoped operator on a shadowed targeted axis still lowers correctly \
through the
purge + memo-reset + einAxisCatch wrapping (regression that the scope \
wrapping did
not break the normal shadowed path).\
\>", "Text",
 CellID->315447832],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Block", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"c", "=", "3"}], "}"}], ",",
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a_", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a", ",", "#c"}], "}"}], "}"}]}], ",",
       RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}]}], "]"}]], "VerificationTest",\

