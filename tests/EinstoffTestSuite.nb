Cell["\<\
composite summand sizing composes with a second direct-sum axis\
\>", "Text",
 CellID->319772518],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
  RowBox[{
   RowBox[{
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{
       RowBox[{"\"\<p\>\"", "\[CirclePlus]", "n_"}], ",",
       RowBox[{
        RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], "\[CirclePlus]",
         "c_"}], ",", "x_"}], "}"}], "}"}], "\[RuleDelayed]",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"\"\<p\>\"", ",",
        RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], ",", "x"}],
       "}"}], ",",
      RowBox[{"{",
       RowBox[{"\"\<p\>\"", ",", "c", ",", "x"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"n", ",",
        RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], ",", "x"}],
       "}"}], ",",
      RowBox[{"{",
       RowBox[{"n", ",", "c", ",", "x"}], "}"}]}], "}"}]}], ",",
   RowBox[{"{",
    RowBox[{"ArrayReshape", "[",
     RowBox[{
      RowBox[{"Range", "[", "60", "]"}], ",",
      RowBox[{"{",
       RowBox[{"3", ",", "10", ",", "2"}], "}"}]}], "]"}], "}"}], ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{"\"\<p\>\"", "\[Rule]", "1"}], ",",
     RowBox[{"\"\<a\>\"", "\[Rule]", "2"}], ",",
     RowBox[{"\"\<b\>\"", "\[Rule]", "3"}]}], "}"}]}],
  "]"}]], "VerificationTest",
 CellID->278069911],

