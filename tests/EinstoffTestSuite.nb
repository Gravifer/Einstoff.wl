Cell["\<\
39. Split must NOT silently drop a NAMED size > 1 summand: 'b (q + k) -> b q, \
b'
with k = 2 would truncate the second block (data loss) \[LongDash] reject \
centrally.  (Only
a size-1 unit summand may be squeezed, tests 32/38; name+carry it via test \
36.)\
\>", "Text",
 CellID->789412949],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"b_", ",",
        RowBox[{"q", "\[CirclePlus]", "k"}]}], "}"}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"b", ",", "q"}], "}"}], ",",
       RowBox[{"{", "b", "}"}]}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "5"}], "}"}]}], "]"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"q", "\[Rule]", "3"}], ",",
      RowBox[{"k", "\[Rule]", "2"}]}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->653039695],

