Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"5", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<q\>\"", "\[CirclePlus]", "k_"}], ",", "m_"}], "}"}], 
       "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<q\>\"", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "m"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", "y", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<q\>\"", "\[Rule]", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->137196714,ExpressionUUID->"a7c4a7eb-09c3-6d42-88ba-cb223ff02222"],

