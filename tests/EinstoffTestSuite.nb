Cell["\<\
6f. Context robustness: a #b bracket resolves to the desc's OWN symbol b (not a
$Context-dependent Symbol[\"b\"]), so an unusual $Context does not break the \
match
between #b on the input and a bare b on the output.\
\>", "Text",
 CellID->74524510,ExpressionUUID->"d941892f-6a56-5b4e-8bce-62a2cde89cb4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"$Context", "=", "\"\<Sandbox`\>\""}], ",", 
     RowBox[{"$ContextPath", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<System`\>\"", ",", "\"\<Einstoff`\>\""}], "}"}]}]}], 
    "}"}], ",", 
   RowBox[{"out", "[", 
    RowBox[{"Einstoff`EinstoffShapes", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}], "]"}]}], 
