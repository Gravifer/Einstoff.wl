Cell["\<\
40. Concat must NOT silently drop a size > 1 operand axis into a size-1 \
summand:
'b c, b k -> b (c + 1)' discards most of the second operand \[LongDash] \
reject.\
\>", "Text",
 CellID->789070525],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"b_", ",", "c_"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"b_", ",", "k_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"b", ",",
        RowBox[{"c", "\[CirclePlus]", "1"}]}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"10", "+",
         RowBox[{"Range", "[", "4", "]"}]}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->145632638],

