Cell["\<\
36. The escape hatch is to NAME the summand, giving it an identity to carry:
'b (q + k) -> b q, b k' with k = 2 works (einx accepts this), as the basic \
split.\
\>", "Text",
 CellID->646623045],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"q", "\[CirclePlus]", "k"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"b", ",", "q"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "x", "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"q", "\[Rule]", "3"}], ",",
       RowBox[{"k", "\[Rule]", "2"}]}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->327256927],

