Cell["\<\
13. Split into two outputs 'b (q + k) -> b q, b k', q=3 (SPEC ex3)
=== native Take of the two contiguous blocks.\
\>", "Text",
 CellID->290229935],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"\"\<q\>\"", "\[CirclePlus]", "k_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"b", ",", "\"\<q\>\""}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "x", "}"}], ",",
     RowBox[{"{",
      RowBox[{"\"\<q\>\"", "\[Rule]", "3"}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->343900072],

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
