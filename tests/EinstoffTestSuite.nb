             RowBox[{"a_", ",", "#b", ",", "#c"}], "}"}], "}"}], "\[RuleDelayed]",
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a", ",", "#b", ",", "#c"}], "}"}], "}"}]}], ",",
          RowBox[{"{", "x", "}"}]}], "]"}]}], ",",
       RowBox[{"want", "=",
        RowBox[{"With", "[",
         RowBox[{
          RowBox[{"{",
           RowBox[{"v", "=",
            RowBox[{"Flatten", "[",
             RowBox[{
             "x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
             "]"}]}], "}"}], ",",
          RowBox[{"{",
           RowBox[{"ArrayReshape", "[",
            RowBox[{
             RowBox[{
              RowBox[{"(",
               RowBox[{"v", "-",
                RowBox[{"Max", "[", "v", "]"}]}], ")"}], "-",
              RowBox[{"Log", "[",
               RowBox[{"Total", "[",
                RowBox[{"Exp", "[",
                 RowBox[{"v", "-",
                  RowBox[{"Max", "[", "v", "]"}]}], "]"}], "]"}], "]"}]}], ",",
             RowBox[{"{",
              RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "}"}]}], "]"}]}]}],
      "}"}], ",",
     RowBox[{
      RowBox[{"Chop", "[",
       RowBox[{"got", "-", "want"}], "]"}], "\[Equal]",
      RowBox[{"ConstantArray", "[",
       RowBox[{"0", ",",
        RowBox[{"{",
         RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}]}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->912142795],

