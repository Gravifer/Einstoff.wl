        RowBox[{"{", 
         RowBox[{"n_", ",", "c_", ",", "d_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"n", ",", "a", ",", "d"}], "}"}], "}"}]}], ",", 
