Cell["\<\
15. Three-way split 'b (p + q + r) -> b p, b q, b r', p=2, q=3.\
\>", "Text",
 CellID->176589881,ExpressionUUID->"61a9f1d5-336a-f941-a59b-474f00719742"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"b_", ",", 
         RowBox[{"\"\<p\>\"", "\[CirclePlus]", "\"\<q\>\"", "\[CirclePlus]", 
          "r_"}]}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b", ",", "\"\<p\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "\"\<q\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "r"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", "z", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<p\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<q\>\"", "\[Rule]", "3"}]}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
