Cell[CellGroupData[{

Cell["Reduce.wlt", "Section",
 CellID->487237399],

Cell["\<\
Cross-validation tests for the reduce lowering: Einstoff[ArrayReduce] checked
against the actual einx / einops reductions (SPEC \[Section]10.1). Companion to
tests/python/Reshape.wlt; see that file for the full rationale.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.

Scope note: cross-validation here uses sum and max only \[LongDash] both \
integer-exact,
so comparison is by exact equality. einops.reduce 'mean' rejects integer
tensors and einx 'mean' returns floats (vs WL's exact rationals), so the mean
reducer is validated in the WL suite (tests/Reduce.wlt) against native Mean
instead.

The session setup / pyDims / pyKwargs helpers are intentionally duplicated
from tests/python/Reshape.wlt to keep each .wlt self-contained; factor into a
shared harness if a third python suite appears.\
\>", "Text",
 CellID->748118737],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->362159722],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->824273821],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->238556197],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->147569128],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->663800877],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->303274095],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{
         "pySession", ",", "\"\<import numpy, einops, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->668871058],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->301930479],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyKwargs", "[", "kw_Association", "]"}], ":=",
  RowBox[{"StringRiffle", "[",
   RowBox[{
    RowBox[{"KeyValueMap", "[",
     RowBox[{
      RowBox[{
       RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
        RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kw"}], "]"}],
    ",", "\"\<, \>\""}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->547553082],

Cell["\<\
pyReduce[backend, reduction, pattern, dims, kwargs]: build the input from
`dims` inside Python, apply the einops/einx reduction, return WL int lists.
einops uses bare patterns ('a b -> a'); einx uses bracket patterns
('a [b] -> a'); the pairing with the Wolfram desc is reasoned out of band.\
\>", "Text",
 CellID->221317217],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyReduce", "[",
   RowBox[{"backend_", ",", "reduction_", ",", "pattern_", ",", "dims_List", ",",
    RowBox[{"kwargs_", ":",
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"prod", "=",
       RowBox[{"Times", "@@", "dims"}]}], ",",
      RowBox[{"kw", "=",
       RowBox[{"pyKwargs", "[", "kwargs", "]"}]}], ",", "call"}], "}"}], ",",

    RowBox[{
     RowBox[{"call", "=",
      RowBox[{"Switch", "[",
       RowBox[{"backend", ",", "\"\<einops\>\"", ",",
        RowBox[{"\"\<einops.reduce(x, \>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"reduction", ",", "InputForm"}], "]"}], "<>",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
           RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)\>\""}],
        ",", "\"\<einx\>\"", ",",
        RowBox[{"\"\<einx.\>\"", "<>", "reduction", "<>", "\"\<(\>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x\>\"", "<>",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
           RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)\>\""}]}],
        "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einops, einx\\n\>\"",
        "<>", "\"\<x = (1 + np.arange(\>\"", "<>",
        RowBox[{"ToString", "[", "prod", "]"}], "<>", "\"\<)).reshape(\>\"", "<>",
        RowBox[{"pyDims", "[", "dims", "]"}], "<>", "\"\<)\\n\>\"",
        "<>", "\"\<(\>\"", "<>", "call", "<>", "\"\<).tolist()\>\""}]}],
      "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->894289744],

