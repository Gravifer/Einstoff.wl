Cell["Inner[Times, Plus] matmul === einx.dot", "Text",
 CellID->766007022],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
   RowBox[{"Times", ",", "Plus"}], "]"}], "[",
  RowBox[{
   RowBox[{
    RowBox[{"{",
