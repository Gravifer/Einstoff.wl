Cell["\<\
35. ...nor can a size > 1 literal summand be PRESERVED as {b, 2}: a literal \
axis is
anonymous and has no carryable identity, so it cannot be matched between \
input and
output \[LongDash] exactly as einx rejects 'b (q + 2) -> b q, b 2' (\"input \
axes {unnamed} must
appear in the output\").  Only size-1 (unit) literals are special (tests \
32-33).\
\>", "Text",
 CellID->416455560],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "10", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"b_", ",",
          RowBox[{"q_", "\[CirclePlus]", "2"}]}], "}"}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"b", ",", "q"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b", ",", "2"}], "}"}]}], "}"}]}], ",",
      RowBox[{"{", "x", "}"}], ",",
      RowBox[{"{",
       RowBox[{"q", "\[Rule]", "3"}], "}"}]}], "]"}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->815632405],

