Cell[CellGroupData[{

Cell["Reshape.wlt", "Section",
 CellID->825200450],

Cell["\<\
Cross-validation tests for the rearrange/reshape lowering: Einstoff's output
is checked against the *actual* einx / einops Python implementations (SPEC
\[Section]10.1), not against hand-written expected arrays.

Opt-in only: run with `wolframscript -script scripts/run-tests.wls python`.
The runner globs tests/python/*.wlt solely when --python (or the plain word
`python`) is given.

Mechanics (SPEC \[Section]10.1):
- ExternalEvaluate over an ephemeral ExternalSessionObject bound directly to
the repo .venv interpreter (no persistent registry mutation; the session
object is itself opaque and is DeleteObject'd at the end). Registering by
UUID and targeting it does NOT work headless under wolframscript, so we
start a session from the Executable spec instead.
- Inputs are rebuilt independently on both sides from a shared dims recipe:
WL  ArrayReshape[Range[Times @@ dims], dims]   (1-based, row-major)
Py  (1 + np.arange(prod)).reshape(dims)        (1+ to match Range; numpy
default C-order = row-major)
so element-wise integer equality is exact (no float tolerance).
- Only the result crosses the boundary, via .tolist() -> WL integer lists.

The Python pattern string <-> Wolfram desc equivalence in each test is reasoned
OUT OF BAND and written by hand (SPEC \[Section]10.1); only the implemented \
reshape
subset is required to agree.

BeginTestSection[name, pythonReady] skips (not fails) the whole section when
Python / the packages are unavailable.\
\>", "Text",
 CellID->603472105],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->702302103],

Cell["\<\
Project root: exported by the runner; fall back to the loaded paclet's
location so the file is also usable via a bare TestReport[...].\
\>", "Text",
 CellID->983267040],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->422233785],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->345454566],

Cell["\<\
Reuse the runner's shared session if it spawned one (one ZMQ session per kernel
is stable, many are not); otherwise spawn our own so the file still runs \
under a
bare TestReport, and own only that teardown.\
\>", "Text",
 CellID->581753725],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->271931034],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->606776800],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{
         "pySession", ",", "\"\<import numpy, einops, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->594401747],

Cell["\<\
---- reference helper --------------------------------------------------\
\>", "Text",
 CellID->348555352],

Cell["\<\
pyRef[backend, pattern, dims, kwargs] rebuilds the input from `dims` inside
Python, applies the einops/einx call, and returns the result as WL integer
lists. dims/kwargs are rendered in Python syntax (brackets, not braces).\
\>", "Text",
 CellID->46335818],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->877001077],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyKwargs", "[", "kw_Association", "]"}], ":=",
  RowBox[{"StringRiffle", "[",
   RowBox[{
    RowBox[{"KeyValueMap", "[",
     RowBox[{
      RowBox[{
       RowBox[{"#1", "<>", "\"\<=\>\"", "<>",
        RowBox[{"ToString", "[", "#2", "]"}]}], "&"}], ",", "kw"}], "]"}],
    ",", "\"\<, \>\""}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->705544778],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyRef", "[",
   RowBox[{"backend_", ",", "pattern_", ",", "dims_List", ",",
    RowBox[{"kwargs_", ":",
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"prod", "=",
       RowBox[{"Times", "@@", "dims"}]}], ",",
      RowBox[{"kw", "=",
       RowBox[{"pyKwargs", "[", "kwargs", "]"}]}], ",", "call"}], "}"}], ",",

    RowBox[{
     RowBox[{"call", "=",
      RowBox[{"Switch", "[",
       RowBox[{"backend", ",", "\"\<einops\>\"", ",",
        RowBox[{"\"\<einops.rearrange(x, \>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
           RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)\>\""}],
        ",", "\"\<einops.repeat\>\"", ",",
        RowBox[{"\"\<einops.repeat(x, \>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
           RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)\>\""}],
        ",", "\"\<einx\>\"", ",",
        RowBox[{"\"\<einx.id(\>\"", "<>",
         RowBox[{"ToString", "[",
          RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x\>\"", "<>",
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",",
           RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], "<>", "\"\<)\>\""}]}],
        "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einops, einx\\n\>\"",
        "<>", "\"\<x = (1 + np.arange(\>\"", "<>",
        RowBox[{"ToString", "[", "prod", "]"}], "<>", "\"\<)).reshape(\>\"", "<>",
        RowBox[{"pyDims", "[", "dims", "]"}], "<>", "\"\<)\\n\>\"",
        "<>", "\"\<(\>\"", "<>", "call", "<>", "\"\<).tolist()\>\""}]}],
      "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->670563519],

