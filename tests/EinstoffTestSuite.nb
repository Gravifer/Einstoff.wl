     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3", ",", "2", ",", "5"}], "}"}], "}"}]}], "]"}], 
  "]"}]], "VerificationTest",
 CellID->708435059,ExpressionUUID->"be806577-aaa3-1549-85be-487023087b38"],

