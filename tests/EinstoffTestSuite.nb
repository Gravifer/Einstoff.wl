Cell["\<\
17b. Multiple direct-sum axes split into Cartesian blocks, last axis fastest:
'(a + d) (b + c) -> a b, a c, d b, d c'.\
\>", "Text",
 CellID->340141270],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"z", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{
        RowBox[{"Range", "[", "15", "]"}], "-", "1"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{
         RowBox[{"\"\<a\>\"", "\[CirclePlus]", "d_"}], ",",
         RowBox[{"\"\<b\>\"", "\[CirclePlus]", "c_"}]}], "}"}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
