Cell["\<\
12. The user-supplied combiner runs inside our tagged Catch \
(einCatch/einThrowTag).
A combiner that itself Throws (untagged) must PROPAGATE past our control \
flow, not be
swallowed as our $Failed sentinel.  Discriminating probe: wrap the call in an \
inert
head `mark` inside the user's own Catch.  If the throw propagates (correct), \
it skips
`mark` and the user Catch returns the raw payload \"boom\"; were it swallowed \
(the old
bug), the operator would RETURN \"boom\" normally and the user Catch would \
see the wrapped
mark[\"boom\"] instead.  So `=== \"boom\"` holds iff the throw escaped our \
control flow.\
\>", "Text",
 CellID->129419848],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Catch", "[",
  RowBox[{"mark", "[",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
     RowBox[{"Times", ",",
      RowBox[{"Function", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{"x", ",", "y"}], "}"}], ",",
        RowBox[{"Throw", "[", "\"\<boom\>\"", "]"}]}], "]"}]}], "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"a_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "12", "]"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}], "]"}],
  "]"}]], "VerificationTest",
 CellID->362958167],

Cell[BoxData["\"\<boom\>\""], "ExpectedOutput",
 CellID->682744092],

Cell[BoxData[
 RowBox[{"{", "}"}]], "ExpectedMessage",
 CellID->96292976],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"TestID", "\[Rule]", "\"\<inner-user-throw-propagates\>\""}],
  "}"}]], "TestOptions",
 CellID->273083526],

