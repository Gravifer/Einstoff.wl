Cell[CellGroupData[{

Cell["Inner.wlt", "Section",
 CellID->860674078],

Cell["\<\
Cross-validation for the generalized contraction: only Einstoff[Inner][Times,
Plus] has an einx equivalent (it IS einx.dot), so that is what we check against
the external oracle \[LongDash] confirming Inner's base case reduces to \
einx.dot. Other
combiners (tropical, max-product, \[Ellipsis]) have no einx counterpart and \
are validated
against native WL Inner in tests/Inner.wlt.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Session setup duplicated from the other python suites (self-contained).\
\>", "Text",
 CellID->362738525],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->590164422],

Cell[BoxData[
 RowBox[{"pyRoot", "=",
  RowBox[{"If", "[",
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",",
    "Einstoff`Tests`$Root", ",",
    RowBox[{"ParentDirectory", "[",
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}],
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->235766323],

Cell[BoxData[
 RowBox[{"pyExe", "=",
  RowBox[{"FileNameJoin", "[",
   RowBox[{"{",
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->984415471],

Cell[BoxData[
 RowBox[{"pyOwned", "=",
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=",
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->432164725],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->734729728],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->999874632],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=",
  RowBox[{"\"\<[\>\"", "<>",
   RowBox[{"StringRiffle", "[",
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}],
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->558993853],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDotN", "[",
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"setup", ",", "args"}], "}"}], ",",
    RowBox[{
     RowBox[{"setup", "=",
      RowBox[{"StringJoin", "[",
       RowBox[{"MapIndexed", "[",
        RowBox[{
         RowBox[{
          RowBox[{"With", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{
              RowBox[{"nm", "=",
               RowBox[{"\"\<x\>\"", "<>",
                RowBox[{"ToString", "[",
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",",
              RowBox[{"d", "=", "#1"}]}], "}"}], ",",
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>",
             RowBox[{"ToString", "[",
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>",
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}],
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";",
     RowBox[{"args", "=",
      RowBox[{"StringRiffle", "[",
       RowBox[{
        RowBox[{"Table", "[",
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>",
           RowBox[{"ToString", "[", "i", "]"}]}], ",",
          RowBox[{"{",
           RowBox[{"i", ",", "0", ",",
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}],
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";",
     RowBox[{"ExternalEvaluate", "[",
      RowBox[{"pySession", ",",
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup",
        "<>", "\"\<np.asarray(einx.dot(\>\"", "<>",
        RowBox[{"ToString", "[",
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",\

 InitializationCell->True,
 CellID->425127530],

