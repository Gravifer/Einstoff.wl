       RowBox[{
        RowBox[{"{",
         RowBox[{"30", ",", "31", ",", "32"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"33", ",", "34", ",", "35"}], "}"}]}], "}"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"a_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"a_", ",", "c_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"d_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"d_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{
         RowBox[{"a", "\[CirclePlus]", "d"}], ",",
