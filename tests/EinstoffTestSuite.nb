Cell["\<\
22c. A Protected+Locked stray token survives the boundary purge, so \
axisSymbol falls
back to a genuinely fresh Unique identity (in Einstoff`Fallback`): the env \
key is a
value-less Symbol (name \"protlk$nn\"), never the leaked value.\
\>", "Text",
 CellID->970115605],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff`Axis`protlk", "=", "21"}], ";",
  RowBox[{"SetAttributes", "[",
   RowBox[{"Einstoff`Axis`protlk", ",",
    RowBox[{"{",
     RowBox[{"Protected", ",", "Locked"}], "}"}]}], "]"}], ";",
  RowBox[{"With", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"env", "=",
      RowBox[{"Block", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{"protlk", "=", "1"}], "}"}], ",",
        RowBox[{"Quiet", "[",
         RowBox[{
          RowBox[{"Einstoff`EinstoffMatch", "[",
           RowBox[{
            RowBox[{"{",
             RowBox[{"{", "\"\<protlk\>\"", "}"}], "}"}], ",",
            RowBox[{"{",
             RowBox[{"{", "5", "}"}], "}"}]}], "]"}], "[", "\"\<env\>\"",
          "]"}], "]"}]}], "]"}]}], "}"}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"MatchQ", "[",
       RowBox[{
        RowBox[{"Keys", "[", "env", "]"}], ",",
        RowBox[{"{", "_Symbol", "}"}]}], "]"}], ",",
      RowBox[{"FreeQ", "[",
       RowBox[{
        RowBox[{"Keys", "[", "env", "]"}], ",", "21"}], "]"}], ",",
      RowBox[{"Values", "[", "env", "]"}]}], "}"}]}],
   "]"}]}]], "VerificationTest",
 CellID->80404086],

