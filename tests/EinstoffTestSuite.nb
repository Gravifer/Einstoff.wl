   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->502563174],

Cell[BoxData[
 RowBox[{"pySession", "=",
  RowBox[{"If", "[",
   RowBox[{"pyOwned", ",",
    RowBox[{"Quiet", "[",
     RowBox[{"Check", "[",
      RowBox[{
       RowBox[{"If", "[",
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",",
         RowBox[{"StartExternalSession", "[",
          RowBox[{"Association", "[",
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",",
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}],
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->481435319],

Cell[BoxData[
 RowBox[{"pythonReady", "=",
  RowBox[{"TrueQ", "[",
   RowBox[{"Quiet", "[",
    RowBox[{"Check", "[",
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===",
        "ExternalSessionObject"}], "&&",
       RowBox[{
        RowBox[{"ExternalEvaluate", "[",
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}],
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}],
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->716868844],

Cell["\<\
Run einx `call` (a Python expression in x) on the array built by `pyInput`
(a Python expression), returning the result as a nested list.\
\>", "Text",
 CellID->540761436],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyMap", "[",
   RowBox[{"call_String", ",", "pyInput_String"}], "]"}], ":=",
  RowBox[{"ExternalEvaluate", "[",
   RowBox[{"pySession", ",",
    RowBox[{"\"\<import numpy as np, einx\\nx = \>\"", "<>", "pyInput",
     "<>", "\"\<\\nnp.asarray(\>\"", "<>", "call",
     "<>", "\"\<).tolist()\>\""}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->400755637],

Cell[BoxData[
 RowBox[{
  RowBox[{"approxEqual", "[",
   RowBox[{"u_", ",", "v_"}], "]"}], ":=",
  RowBox[{
   RowBox[{"Max", "[",
    RowBox[{"Abs", "[",
     RowBox[{"Flatten", "[",
      RowBox[{
       RowBox[{"N", "[", "u", "]"}], "-", "v"}], "]"}], "]"}], "]"}], "<",
   "1.`*^-9"}]}]], "Input",
 InitializationCell->True,
 CellID->621990300],

