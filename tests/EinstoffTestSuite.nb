Cell["\<\
19. A globally bound non-size value is rejected by the existing checks.  NB the
shadow value must be neither a valid size NOR a valid axis-name string (a \
string is
now a legal axis spelling): a Real like 2.5 is a genuine non-size that \
env-captures
into an illegal dimension term and is rejected.\
\>", "Text",
 CellID->273136977,ExpressionUUID->"8b05e94c-dbe1-174d-8c7d-feadfbba2831"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"k", "=", "2.5`"}], "}"}], ",", 
   RowBox[{"Quiet", "[", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"Range", "[", "12", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"a_", ",", "k"}], "}"}], "}"}], "\[RuleDelayed]", 
         RowBox[{"{", 
          RowBox[{"{", "a", "}"}], "}"}]}], ",", 
        RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->638464937,ExpressionUUID->"6e564de5-df94-fd40-9dc8-a6bace31bfbf"],

