Cell["\<\
22. A unit (size-1) literal operand axis is squeezed, so 'a 1, b -> a b' (== \
einx
'a (), b') is an outer product \[LongDash] the {} spelling behaves \
identically.\
\>", "Text",
 CellID->144861966],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"Range", "[", "4", "]"}]}]}], "}"}], ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"{",
           RowBox[{"a_", ",", "1"}], "}"}], ",",
          RowBox[{"{", "b_", "}"}]}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
       RowBox[{"{",
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",",
     RowBox[{
      RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"{",
           RowBox[{"a_", ",",
            RowBox[{"{", "}"}]}], "}"}], ",",
          RowBox[{"{", "b_", "}"}]}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",",
       RowBox[{"{",
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "}"}]}],
