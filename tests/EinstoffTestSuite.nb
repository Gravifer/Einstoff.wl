Cell["\<\
16. An axis name inside a bracketed composite (Slot[(c d)]) is canonicalized \
like any
grammar position: under a shadowing Block it still resolves, matching the
unshadowed result.\
\>", "Text",
 CellID->706083522],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "18", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Block", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"c", "=", "3"}], "}"}], ",",
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a_", ",",
           RowBox[{"Slot", "[",
            RowBox[{"c_", "\[CircleTimes]", "d_"}], "]"}]}], "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{", "a", "}"}], "}"}]}], ",",
       RowBox[{"{", "x", "}"}], ",",
       RowBox[{"{",
        RowBox[{"d", "\[Rule]", "2"}], "}"}]}], "]"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->758099870],

