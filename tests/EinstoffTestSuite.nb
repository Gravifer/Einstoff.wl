        RowBox[{"{", "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b", ",",
         RowBox[{"c", "\[CirclePlus]", "1"}]}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"x", ",", "42"}], "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->577845104],

