    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"",
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->592561325],

Cell[BoxData[
