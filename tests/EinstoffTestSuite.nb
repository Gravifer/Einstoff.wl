       RowBox[{"Range", "[", "10", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"b_", ",",
          RowBox[{"q_", "\[CirclePlus]", "2"}]}], "}"}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{
         RowBox[{"{",
          RowBox[{"b", ",", "q"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"b", ",", "2"}], "}"}]}], "}"}]}], ",",
      RowBox[{"{", "x", "}"}]}], "]"}], "]"}]}], "]"}]], "VerificationTest",
 CellID->483571484],

