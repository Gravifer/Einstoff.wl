          RowBox[{"a_", ",", "c_"}], "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"c", ",", "a"}], "}"}], "}"}]}], ",",
       RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}]}], "]"}]], "VerificationTest",\

