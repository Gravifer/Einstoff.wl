Cell["\<\
16. An axis name inside a targeted composite (Slot[(c d)]) is canonicalized \
like any
grammar position: under a shadowing Block it still resolves, matching the
unshadowed result.  The supplied factor is string-spelled; c_ remains \
inferred.\
\>", "Text",
 CellID->901173734],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "18", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Block", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"c", "=", "3"}], "}"}], ",",
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{"{",
          RowBox[{"a_", ",",
           FrameBox[
            RowBox[{"c_", "\[CircleTimes]", "\"\<d\>\""}],
            DefaultBaseStyle->"HighlightedInput",
            FrameStyle->None,
            StripOnInput->False]}], "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{", "a", "}"}], "}"}]}], ",",
       RowBox[{"{", "x", "}"}], ",",
       RowBox[{"{",
        RowBox[{"\"\<d\>\"", "\[Rule]", "2"}], "}"}]}], "]"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->71995867],

