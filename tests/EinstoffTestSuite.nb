       RowBox[{"{",
        RowBox[{"{", "3", "}"}], "}"}]}], "]"}], "[", "\"\<Reason\>\"", "]"}],
     ",", "\"\<must be of the form\>\""}], "]"}]}]], "VerificationTest",
 CellID->727272101],

