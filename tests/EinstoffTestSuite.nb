Cell["\<\
===================== composite summands (concat) ===============\
\>", "Text",
 CellID->931122224,ExpressionUUID->"87ba20c2-e350-b645-bbaa-a7dea1eb5eff"],

Cell["\<\
A direct-sum summand may be a product block (a CircleTimes), e.g. (a\
\[CircleTimes]b) \[CirclePlus] c.
Supported in BOTH directions: concat here, and split below (the CAS matcher
solveComposite resolves the block's factor sizes; see SPEC \[Section]9).\
\>", "Text",
 CellID->757602391,ExpressionUUID->"29f61584-a10b-754f-8480-bb7d1f71d941"],

Cell["\<\
24. Composite block whose operand is pre-merged: 'm (a b), m c -> m ((a b) + \
c)', a=2.\
\>", "Text",
 CellID->412951001,ExpressionUUID->"0737d884-8549-5648-8cf8-14d560591d6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "6"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m_", ",", 
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "b_"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "b"}], "\[CirclePlus]", 
          "c"}]}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<a\>\"", "\[Rule]", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->417229966,ExpressionUUID->"20c559e2-93f1-f646-8d0c-ac645a8bf2b5"],

