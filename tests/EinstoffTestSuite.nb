Cell["Inner.wlt", "Section",
 CellID->579846786,ExpressionUUID->"a2b8c157-d40f-c34e-9f43-629c4f77425f"],

Cell["\<\
Cross-validation for the generalized contraction: only Einstoff[Inner][Times,
Plus] has an einx equivalent (it IS einx.dot), so that is what we check against
the external oracle \[LongDash] confirming Inner's base case reduces to \
einx.dot. Other
combiners (tropical, max-product, \[Ellipsis]) have no einx counterpart and \
are validated
against native WL Inner in tests/Inner.wlt.

Opt-in only: `wolframscript -script scripts/run-tests.wls python`.
Session setup duplicated from the other python suites (self-contained).\
\>", "Text",
 CellID->567577724,ExpressionUUID->"2c75e196-1596-664f-bb1c-6a6c3f4079fa"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->819111053,ExpressionUUID->"f941d844-9cbb-5249-bd22-095d6dac250f"],

Cell[BoxData[
 RowBox[{"pyRoot", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "Einstoff`Tests`$Root", "]"}], ",", 
    "Einstoff`Tests`$Root", ",", 
    RowBox[{"ParentDirectory", "[", 
     RowBox[{
      RowBox[{"PacletObject", "[", "\"\<Einstoff\>\"", "]"}], 
      "[", "\"\<Location\>\"", "]"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->795640328,ExpressionUUID->"653f7290-1091-6b44-9e7f-75fba913ddca"],

Cell[BoxData[
 RowBox[{"pyExe", "=", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
    "pyRoot", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"", 
     ",", "\"\<python.exe\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->860112222,ExpressionUUID->"8971b53e-ae86-244d-bef3-ff945fb27e90"],

Cell[BoxData[
 RowBox[{"pyOwned", "=", 
  RowBox[{
   RowBox[{"Head", "[", "Einstoff`Tests`$PySession", "]"}], "=!=", 
   "ExternalSessionObject"}]}]], "Input",
 InitializationCell->True,
 CellID->831695774,ExpressionUUID->"c973f09a-3587-814d-ae1e-3d443c4645ca"],

Cell[BoxData[
 RowBox[{"pySession", "=", 
  RowBox[{"If", "[", 
   RowBox[{"pyOwned", ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", "pyExe", "]"}], ",", 
         RowBox[{"StartExternalSession", "[", 
          RowBox[{"Association", "[", 
           RowBox[{
            RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
            RowBox[{"\"\<Executable\>\"", "\[Rule]", "pyExe"}]}], "]"}], 
          "]"}], ",", "$Failed"}], "]"}], ",", "$Failed"}], "]"}], "]"}], ",",
     "Einstoff`Tests`$PySession"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->77654452,ExpressionUUID->"552c43ac-319f-c44f-96f5-845ea3a117ab"],

Cell[BoxData[
 RowBox[{"pythonReady", "=", 
  RowBox[{"TrueQ", "[", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "pySession", "]"}], "===", 
        "ExternalSessionObject"}], "&&", 
       RowBox[{
        RowBox[{"ExternalEvaluate", "[", 
         RowBox[{"pySession", ",", "\"\<import numpy, einx; True\>\""}], 
         "]"}], "===", "True"}]}], ",", "False"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellID->564270142,ExpressionUUID->"be5241a9-69d8-2a43-9952-c3bfc1c97a36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDims", "[", "l_List", "]"}], ":=", 
  RowBox[{"\"\<[\>\"", "<>", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"ToString", "/@", "l"}], ",", "\"\<, \>\""}], "]"}], 
   "<>", "\"\<]\>\""}]}]], "Input",
 InitializationCell->True,
 CellID->592214411,ExpressionUUID->"45192596-e0ab-6247-a5bb-71a14dd61b52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDotN", "[", 
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setup", ",", "args"}], "}"}], ",", 
    RowBox[{
     RowBox[{"setup", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nm", "=", 
               RowBox[{"\"\<x\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",", 
              RowBox[{"d", "=", "#1"}]}], "}"}], ",", 
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>", 
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}], 
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";", 
     RowBox[{"args", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"pySession", ",", 
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup", 
        "<>", "\"\<np.asarray(einx.dot(\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",\

 InitializationCell->True,
 CellID->280997918,ExpressionUUID->"f23e1066-3dc4-0a42-9d29-4bea6be8ca30"],

