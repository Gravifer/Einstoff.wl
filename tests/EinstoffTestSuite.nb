Cell["\<\
10b. A name repeated within an input shape is within-tensor contraction, not \
reduction
\[LongDash] ArrayReduce rejects it (its own policy; EinstoffShapes no longer \
gates this).\
\>", "Text",
 CellID->185653604,ExpressionUUID->"f97f6100-8105-d24a-b55b-812567e592ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_", ",", "a_"}], "}"}], "}"}], "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"{", "b", "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",", 
       RowBox[{"{", 
