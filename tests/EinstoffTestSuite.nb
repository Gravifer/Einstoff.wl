Cell["\<\
7. Two adjacent brackets flatten into one op axis ([b][c] == [b c]); flip
reverses the whole flattened block (cf. SPEC 7.3).\
\>", "Text",
 CellID->155471889,ExpressionUUID->"a7f6e8ac-33b4-b744-a9e9-0f52afbe6969"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
