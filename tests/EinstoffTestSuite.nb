Cell["\<\
31. The CAS uniquely resolves a system einx rejects: 'm (a + b) -> m a, m b'
with no bindings and an axis of size 2 forces a = b = 1.\
\>", "Text",
 CellID->145339244,ExpressionUUID->"e2d87cad-abf0-784f-8374-ae30697fc4b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"w", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"m_", ",", 
         RowBox[{"a_", "\[CirclePlus]", "b_"}]}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", "a"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "b"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", "w", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
 CellID->218783462,ExpressionUUID->"d01304a3-c295-db42-9ec7-e156ad59abf3"],

Cell[BoxData[
 RowBox[{"With", "[", 
