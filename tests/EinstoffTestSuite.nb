       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<einsum\>\"", "]"}], "[",
