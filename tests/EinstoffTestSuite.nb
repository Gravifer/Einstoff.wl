Cell["\<\
23. Nested split 'b (q + (a + k)) -> b q, b a, b k', q=2, a=3 === flat 3-way.\
\
\>", "Text",
 CellID->287556704],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"w", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"b_", ",",
         RowBox[{"\"\<q\>\"", "\[CirclePlus]",
          RowBox[{"(",
           RowBox[{"\"\<a\>\"", "\[CirclePlus]", "k_"}], ")"}]}]}], "}"}],
       "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"b", ",", "\"\<q\>\""}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "\"\<a\>\""}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"b", ",", "k"}], "}"}]}], "}"}]}], ",",
     RowBox[{"{", "w", "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"\"\<q\>\"", "\[Rule]", "2"}], ",",
       RowBox[{"\"\<a\>\"", "\[Rule]", "3"}]}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->21925775],

