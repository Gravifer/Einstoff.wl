           RowBox[{"a_", ",", "k"}], "}"}], "}"}], "\[RuleDelayed]",
         RowBox[{"{",
          RowBox[{"{", "a", "}"}], "}"}]}], ",",
        RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}], "]"}]}],
  "]"}]], "VerificationTest",
