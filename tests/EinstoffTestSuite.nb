Cell["6. Contract then merge survivors 'a b, b c -> (a c)'.", "Text",
 CellID->317863985,ExpressionUUID->"c733d107-bce5-684b-b709-67d6786e20ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "Dot", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
