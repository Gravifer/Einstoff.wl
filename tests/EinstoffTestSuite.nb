Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[",

    RowBox[{
     RowBox[{
