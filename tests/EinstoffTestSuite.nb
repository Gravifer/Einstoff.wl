Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{"Block", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"c", "=", "3"}], "}"}], ",",
     RowBox[{"Quiet", "[",
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[",
        RowBox[{
         RowBox[{
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a_", ",",
             FrameBox["c_",
              DefaultBaseStyle->"HighlightedInput",
              FrameStyle->None,
              StripOnInput->False]}], "}"}], "}"}], "\[RuleDelayed]",
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
         RowBox[{"{", "x", "}"}], ",",
         RowBox[{"{",
          RowBox[{"c", "\[Rule]", "2"}], "}"}]}], "]"}], ",",
       RowBox[{"{",
        StyleBox[
         RowBox[{"Einstoff", "::", "evalkey"}], "MessageName"], "}"}]}],
      "]"}]}], "]"}]}], "]"}]], "VerificationTest",
