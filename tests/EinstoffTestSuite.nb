Cell["\<\
21. A desc-reject reason does not leak across re-entrant parses: after an \
invalid-name
(rule) reject, a subsequent malformed (non-rule) desc must report the GENERIC
desc-shape reason, not the stale invalid-name reason ($descRejectReason is \
reset
per parse, not just per scope).\
\>", "Text",
 CellID->854840827,ExpressionUUID->"d243f5bf-51a3-a34a-8623-1ddc0d056166"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Quiet", "[", 
   RowBox[{"Einstoff`EinstoffShapes", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", "\"\<a b\>\"", "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", "\"\<a b\>\"", "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"{", "3", "}"}], "}"}]}], "]"}], "]"}], ";", 
  RowBox[{"StringContainsQ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff`EinstoffShapes", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", "a_", "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", "3", "}"}], "}"}]}], "]"}], "[", "\"\<Reason\>\"", "]"}],
     ",", "\"\<must be of the form\>\""}], "]"}]}]], "VerificationTest",
 CellID->317274701,ExpressionUUID->"70ff132d-6879-ff43-b6bb-00515db3af1a"],

Cell[BoxData["True"], "ExpectedOutput",
 CellID->418443933,ExpressionUUID->"e478a9a1-f746-9a48-8dbc-354e858e0710"],

