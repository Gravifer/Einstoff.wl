 CellID->114960254,ExpressionUUID->"95c3a73a-94ea-9c49-87e6-ce0d416d975c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "24", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "40", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4", ",", "5"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"z", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "20", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "5", ",", "2"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "Dot", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n_", ",", "a_", ",", "b_"}], "}"}], ",", 
        RowBox[{"{", 
