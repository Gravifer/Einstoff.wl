Cell["\<\
22. Even a PROTECTED stray value in the private axis context cannot leak \
\[LongDash] the boundary
purge Unprotects before clearing (a plain clear cannot touch a Protected \
symbol).\
\>", "Text",
 CellID->12648798],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff`Axis`ztest", "=", "88"}], ";",
  RowBox[{"Protect", "[", "Einstoff`Axis`ztest", "]"}], ";",
  RowBox[{"Block", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"ztest", "=", "1"}], "}"}], ",",
    RowBox[{"SymbolName", "/@",
     RowBox[{"Keys", "[",
