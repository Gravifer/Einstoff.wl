Cell["\<\
===================== composite summands (split) ===============\
\>", "Text",
 CellID->188850129,ExpressionUUID->"1b235ba8-d9ed-7d47-8bbb-8e7117b58ebb"],

Cell["\<\
Splitting a product block needs the block's factors bound so the matcher can
determine the remaining summand. The CAS (Solve over positive integers) handles
the arithmetic \[LongDash] and resolves any system the integers pin uniquely \
(see #31).\
\>", "Text",
 CellID->768690731,ExpressionUUID->"4dd26b9c-e832-7648-829c-dbf7f1e10025"],

Cell["\<\
28. Split a product block: 'm ((a b) + c) -> m (a b), m c', a=2, b=3 (=> c=4).\
\>", "Text",
 CellID->298264283,ExpressionUUID->"48e7a8c2-12b5-0b4d-a4f3-5782ae07c6fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"m_", ",", 
         RowBox[{
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}], "\[CirclePlus]",
           "c_"}]}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"\"\<a\>\"", "\[CircleTimes]", "\"\<b\>\""}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"m", ",", "c"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"{", "z", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<a\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<b\>\"", "\[Rule]", "3"}]}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->42661217,ExpressionUUID->"60f8c1b6-ac03-a04f-83e9-cb1809584652"],

Cell[BoxData[
 RowBox[{"With", "[", 
