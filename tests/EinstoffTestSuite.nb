Cell["\<\
===================== nested CirclePlus (associativity) =========\
\>", "Text",
 CellID->964536916],

Cell["\<\
CirclePlus is associative: a \[CirclePlus] (b \[CirclePlus] c) flattens to a \
\[CirclePlus] b \[CirclePlus] c (order preserved,
since CirclePlus is not Orderless). Both directions canonicalize the nesting.\
\
\>", "Text",
 CellID->586735425],

Cell["\<\
21. Right-nested concat 'm a, m b, m c -> m (a + (b + c))' === flat 3-way.\
\>", "Text",
 CellID->597854584],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{
     RowBox[{"x", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "2", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ",",
     RowBox[{"y", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "4", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ",",
     RowBox[{"z", "=",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]}], "}"}], ",",
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"m_", ",", "a_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"m_", ",", "b_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"m_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"m", ",",
         RowBox[{"a", "\[CirclePlus]",
          RowBox[{"(",
           RowBox[{"b", "\[CirclePlus]", "c"}], ")"}]}]}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->234604994],

