    RowBox[{"Association", "[",
     RowBox[{
      RowBox[{"a", "\[Rule]", "2"}], ",",
      RowBox[{"b", "\[Rule]", "3"}]}], "]"}]}]}], "]"}]], "ExpectedOutput",
 CellID->827445933],

