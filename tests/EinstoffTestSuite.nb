Cell["\<\
===================== full einx reduction-op coverage =============
Every named reducer at
https://einx.readthedocs.io/en/stable/api/operations/reduction.html resolves to
a list reducer; checked here against an independent WL reference over the
bracketed axis. var/std are *population* (ddof = 0), matching numpy/einx.\
\>", "Text",
 CellID->946482437,ExpressionUUID->"ea7d1824-61d6-6f4c-9705-0e2d02e8c561"],

Cell["20. Population variance (NOT WL's sample Variance).", "Text",
 CellID->89278607,ExpressionUUID->"796fb13a-2b03-514f-8431-c834d11b105a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1.`", ",", "2.`", ",", "4.`", ",", "8.`"}], "}"}], "}"}]}], 
    "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "\"\<var\>\"", "]"}],
     "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", "a", "}"}], "}"}]}], ",", 
     RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}]], "VerificationTest",
