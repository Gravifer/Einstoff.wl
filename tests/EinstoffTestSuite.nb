Cell["\<\
12. A whole-axis binder `a_` is inference-only: binding it is rejected even \
when the
size agrees with the tensor (a composite split-factor binder, by contrast, IS
bindable \[LongDash] see ex2 in Parsing.wlt).  Block[{a}] keeps the bare `a` \
key unshadowed
so it reaches the axis rather than evaluating to a junk key.\
\>", "Text",
 CellID->883461873],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[",
  RowBox[{
   RowBox[{"{", "a", "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
     RowBox[{
      RowBox[{
       RowBox[{"{",
        RowBox[{"{", "a_", "}"}], "}"}], "\[RuleDelayed]",
       RowBox[{"{",
        RowBox[{"{", "a", "}"}], "}"}]}], ",",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"a", "\[Rule]", "3"}], "}"}]}], "]"}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->755070934],

Cell[BoxData["$Failed"], "ExpectedOutput",
 CellID->863646925],

