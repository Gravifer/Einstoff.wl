Cell["\<\
12b. A name repeated within an input shape ('a' in operand 1) is \
within-tensor
contraction, which the direct-sum path cannot do \[LongDash] rejected by its \
own guard.  The
output {{m, a (+) b}} is duplicate-free, so EinstoffShapes is Satisfiable and \
the
rejection is the concat guard's alone (without it the desc reaches lowering and
mis-reshapes \[LongDash] verified, so this test isolates the guard).  Carrier \
'm' shared across
operands is fine (firstDuplicateAxis is per-shape).\
\>", "Text",
 CellID->834039109],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "Join", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"m_", ",", "a_", ",", "a_"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"m_", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"m", ",",
        RowBox[{"a", "\[CirclePlus]", "b"}]}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], "]"}],
  "]"}]], "VerificationTest",
 CellID->386482363],

