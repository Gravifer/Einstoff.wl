Cell["\<\
einops.einsum with tensors then the pattern; inputs 1+arange reshaped, like \
WL Range.\
\>", "Text",
 CellID->171670220,ExpressionUUID->"4c8b36f5-9f24-8845-8364-11fbd7418554"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyEinsum", "[", 
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setup", ",", "args"}], "}"}], ",", 
    RowBox[{
     RowBox[{"setup", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nm", "=", 
               RowBox[{"\"\<x\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",", 
              RowBox[{"d", "=", "#1"}]}], "}"}], ",", 
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>", 
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}], 
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";", 
     RowBox[{"args", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"pySession", ",", 
       RowBox[{"\"\<import numpy as np, einops\\n\>\"", "<>", "setup", 
        "<>", "\"\<np.asarray(einops.einsum(\>\"", "<>", "args", 
        "<>", "\"\<, \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"pattern", ",", "InputForm"}], "]"}], 
        "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->609348580,ExpressionUUID->"0fb62591-c9c7-2f42-8eeb-a32004a9b05e"],

