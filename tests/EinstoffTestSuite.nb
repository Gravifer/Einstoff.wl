Cell["\<\
concat 'm a, m b -> m (a + b)'  <->  {{m_,a_},{m_,b_}} :> {{m, a \
\[CirclePlus] b}}\
\>", "Text",
 CellID->711749741,ExpressionUUID->"792d443a-3c71-a145-90ec-f9cf2233313e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m_", ",", "a_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m_", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{"a", "\[CirclePlus]", "b"}]}], "}"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "6", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "VerificationTest",
 CellID->910339918,ExpressionUUID->"c1927bb5-d999-3441-85ba-fe305e3fe178"],

