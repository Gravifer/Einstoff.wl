Cell["\<\
===== bijective guard: Einstoff[ArrayReshape] rejects non-bijective descs \
=====\
\>", "Text",
 CellID->236354769],

Cell["\<\
The same repetition / contraction / direct-sum descs that Massage accepts are
rejected by the bijective entrance \[LongDash] a repeated OUTPUT-only axis of \
size > 1 is not
an element-count-preserving reindexing.  (A size-1 output-only axis is a unit \
insert,
still bijective \[LongDash] covered by the unit-axis tests below.)\
\>", "Text",
 CellID->89994507],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[",
   RowBox[{
    RowBox[{
     RowBox[{"{",
      RowBox[{"{", "a_", "}"}], "}"}], "\[RuleDelayed]",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
    RowBox[{"{",
     RowBox[{"Range", "[", "4", "]"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"c", "\[Rule]", "3"}], "}"}]}], "]"}], "]"}]], "VerificationTest",\

 CellID->657869980],

