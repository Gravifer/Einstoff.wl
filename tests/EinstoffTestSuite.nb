Cell["\<\
14. A Pattern-form binding key `r_ -> n` is a category error (a matcher, not \
an axis
name) \[LongDash] rejected, not silently ignored (which would let a \
whole-axis blank be
\"bound\" and still succeed by tensor inference).\
\>", "Text",
 CellID->239285814],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[",
  RowBox[{
   RowBox[{"{", "r", "}"}], ",",
   RowBox[{"Quiet", "[",
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
      RowBox[{
       RowBox[{
        RowBox[{"{",
         RowBox[{"{", "r_", "}"}], "}"}], "\[RuleDelayed]",
        RowBox[{"{",
         RowBox[{"{", "r", "}"}], "}"}]}], ",",
       RowBox[{"{",
        RowBox[{"{",
         RowBox[{"1", ",", "2"}], "}"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"r_", "\[Rule]", "2"}], "}"}]}], "]"}], ",",
     RowBox[{"{",
      StyleBox[
       RowBox[{"Einstoff", "::", "unsat"}], "MessageName"], "}"}]}], "]"}]}],
  "]"}]], "VerificationTest",
