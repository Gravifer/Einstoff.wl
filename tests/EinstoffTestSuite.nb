Cell["\<\
4. Agrees with the permissive Massage engine on a contraction desc.\
\>", "Text",
 CellID->972228452,ExpressionUUID->"4f030973-951d-d24f-9bd8-25cf4efbbbb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"R", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "16", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], "}"}], 
   ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<ArrayContract\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "R", "}"}]}], "]"}], "===", 
    RowBox[{
     RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "R", "}"}]}], "]"}]}]}], "]"}]], "VerificationTest",
 CellID->860478960,ExpressionUUID->"aa3fac84-3ada-0744-87ff-e4f1860872e1"],

