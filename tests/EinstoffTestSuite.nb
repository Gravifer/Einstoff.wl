Cell["\<\
13. einsum rejects ANY literal output axis, even one matching an input \
literal
(numpy.einsum has no integer subscripts; a literal output is broadcast, not \
einsum).\
\>", "Text",
 CellID->99332447,ExpressionUUID->"5e3e8b94-8162-6743-be01-931906f98628"],

