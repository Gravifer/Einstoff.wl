     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"w", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"Take", "[", 
      RowBox[{"w", ",", "All", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "ExpectedOutput",
