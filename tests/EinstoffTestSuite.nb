Cell["\<\
13. Matmul, then broadcast the result into a new axis r: 'a [b], [b] c -> a c \
r', r=2.\
\>", "Text",
 CellID->99744736,ExpressionUUID->"90b474a3-1994-c143-93a0-00f4b0e272f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Einstoff", "[", "Dot", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"#b", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a", ",", "c", ",", "r"}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", "\[Rule]", "2"}], "}"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->989094176,ExpressionUUID->"b687ed70-2abc-2e49-a279-a13efa418008"],

