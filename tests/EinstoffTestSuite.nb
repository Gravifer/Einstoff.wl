Cell[CellGroupData[{

Cell["Reduce.wlt", "Section",
 CellID->381217833],

Cell["\<\
Tests for the reduce lowering path (Einstoff[ArrayReduce]).
The reducer is curried: Einstoff[ArrayReduce][reducer][desc, tensors, \
bindings].
One file per lowering path under tests/; cf. Reshape.wlt.
Run via: wolframscript -script scripts/run-tests.wls
BeginTestSection/EndTestSection are MUnit markers; the runner loads MUnit`
so they carry section semantics. The .wlt itself does not import MUnit`.\
\>", "Text",
 CellID->781100413],

Cell[CellGroupData[{

Cell["Einstoff`Lowering`Reduce", "Subsection",
 CellID->827788138],

Cell[BoxData[
 RowBox[{"ClearAll", "[",
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}]], "Input",
 InitializationCell->True,
 CellID->403146504],

Cell["\<\
===================== reductions (einx reduce / einops.reduce) =====\
\>", "Text",
 CellID->632151583],

Cell["\<\
1. einx-style bracket sum 'a [b] -> a' === native sum over axis 2.\
\>", "Text",
 CellID->922896572],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"x", "=",
     RowBox[{"ArrayReshape", "[",
      RowBox[{
       RowBox[{"Range", "[", "12", "]"}], ",",
       RowBox[{"{",
        RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
   RowBox[{
    RowBox[{
