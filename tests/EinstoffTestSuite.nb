Cell["\<\
16. An axis name inside a bracketed composite (Slot[(c d)]) is canonicalized \
like any
grammar position: under a shadowing Block it still resolves, matching the
unshadowed result.\
\>", "Text",
 CellID->214364998,ExpressionUUID->"514bb405-00a1-7144-b458-b40bc35373ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "18", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "6"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", "3"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "Total", "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"a_", ",", 
           RowBox[{"Slot", "[", 
            RowBox[{"c_", "\[CircleTimes]", "d_"}], "]"}]}], "}"}], "}"}], "\[RuleDelayed]", 
        RowBox[{"{", 
         RowBox[{"{", "a", "}"}], "}"}]}], ",", 
       RowBox[{"{", "x", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d", "\[Rule]", "2"}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "VerificationTest",
 CellID->936806992,ExpressionUUID->"81577827-5e99-e44c-a3b7-6d48daa50466"],

