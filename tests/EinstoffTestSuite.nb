Cell["\<\
15e. A bare binding key that evaluated to a System` symbol (e.g. {c->2} under \
c=Null
arrives as {Null->2}) is an evaluated shadow-capture, not a bare axis \
\"Null\": it
is dropped as junk (targeted blank c is sized from the tensor), so no Null
survives as a resolved-bindings KEY.  (Check via Keys \[LongDash] FreeQ does \
not inspect
Association keys.)\
\>", "Text",
 CellID->337088788],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[",
  RowBox[{
   RowBox[{"{",
    RowBox[{"c", "=", "Null"}], "}"}], ",",
   RowBox[{"Sort", "[",
    RowBox[{"bindingKeyName", "/@",
     RowBox[{"Keys", "[",
      RowBox[{"Quiet", "[",
       RowBox[{
        RowBox[{"Einstoff`EinstoffShapes", "[",
         RowBox[{
          RowBox[{
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a_", ",",
              FrameBox["c_",
               DefaultBaseStyle->"HighlightedInput",
               FrameStyle->None,
               StripOnInput->False]}], "}"}], "}"}], "\[RuleDelayed]",
           RowBox[{"{",
            RowBox[{"{",
             RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",",
          RowBox[{"{",
           RowBox[{"{",
            RowBox[{"2", ",", "3"}], "}"}], "}"}], ",",
          RowBox[{"{",
           RowBox[{"c", "\[Rule]", "2"}], "}"}]}], "]"}],
        "[", "\"\<Bindings\>\"", "]"}], "]"}], "]"}]}], "]"}]}],
  "]"}]], "VerificationTest",
 CellID->524608784],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"\"\<a\>\"", ",", "\"\<c\>\""}], "}"}]], "ExpectedOutput",
 CellID->790892773],

