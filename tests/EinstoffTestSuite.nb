  RowBox[{
   RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_", ",", "a_", ",", "d_"}], "}"}], "}"}], "\[RuleDelayed]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"b", ",", "d"}], "}"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "16", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], "}"}]}], 
