Cell["\<\
2. A raw function works identically (the string is just a shortcut).\
\>", "Text",
 CellID->498248590,ExpressionUUID->"e75dfc9b-6b38-0446-a8fc-291ade47d2c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Map", "]"}], "[", "Reverse", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "x", "}"}]}], "]"}], "===", 
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Map", "]"}], "[", "\"\<flip\>\"", "]"}], "[", 
     
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", "x", "}"}]}], "]"}]}]}], "]"}]], "VerificationTest",
 CellID->938226879,ExpressionUUID->"b3e403c3-240c-5b4b-89a6-0d5a2656ea16"],

