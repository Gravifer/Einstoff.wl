Cell["\<\
11b. A name repeated within an input shape is within-tensor contraction, \
which Map
(shape-preserving) does not do \[LongDash] rejected.  The output {{a, #b}} is \
duplicate-free, so
EinstoffShapes is Satisfiable and the rejection comes from Map itself (the \
distinctAxesQ
guard, backed by Map's shape-preserving drop-check \[LongDash] defense in \
depth), not the
resolver's output-uniqueness check.\
\>", "Text",
 CellID->879997080],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Map", "]"}], "[", "Reverse", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a_", ",", "a_", ",", "#b"}], "}"}], "}"}], "\[RuleDelayed]",

      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"a", ",", "#b"}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{"ArrayReshape", "[",
       RowBox[{
        RowBox[{"Range", "[", "16", "]"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "2", ",", "4"}], "}"}]}], "]"}], "}"}]}], "]"}], ",",
   RowBox[{"{",
    StyleBox[
     RowBox[{"Einstoff", "::", "unsupp"}], "MessageName"], "}"}]}],
  "]"}]], "VerificationTest",
 CellID->861650367],

