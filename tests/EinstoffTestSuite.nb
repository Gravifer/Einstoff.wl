Cell["\<\
pyDot[pattern, dims1, dims2, kwargs]: build both operands from their dims
recipes inside Python, apply einx.dot, return WL int lists. kwargs supply any
out-of-band axis sizes (e.g. a repetition axis). The einx pattern <-> the
Wolfram desc equivalence is reasoned out of band.\
\>", "Text",
 CellID->112733582,ExpressionUUID->"dd1edcc7-75ca-3544-a2c4-b90186b5b185"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDot", "[", 
   RowBox[{"pattern_", ",", "dims1_List", ",", "dims2_List", ",", 
    RowBox[{"kwargs_", ":", 
     RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kw", "=", 
      RowBox[{"pyKwargs", "[", "kwargs", "]"}]}], "}"}], ",", 
    RowBox[{"ExternalEvaluate", "[", 
     RowBox[{"pySession", ",", 
      RowBox[{"\"\<import numpy as np, einx\\n\>\"", 
       "<>", "\"\<x = (1 + np.arange(\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Times", "@@", "dims1"}], "]"}], "<>", "\"\<)).reshape(\>\"", 
       "<>", 
       RowBox[{"pyDims", "[", "dims1", "]"}], "<>", "\"\<)\\n\>\"", 
       "<>", "\"\<y = (1 + np.arange(\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Times", "@@", "dims2"}], "]"}], "<>", "\"\<)).reshape(\>\"", 
       "<>", 
       RowBox[{"pyDims", "[", "dims2", "]"}], "<>", "\"\<)\\n\>\"", 
       "<>", "\"\<np.asarray(einx.dot(\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, x, y\>\"", 
       "<>", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"kw", "===", "\"\<\>\""}], ",", "\"\<\>\"", ",", 
         RowBox[{"\"\<, \>\"", "<>", "kw"}]}], "]"}], 
       "<>", "\"\<)).tolist()\>\""}]}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellID->724898792,ExpressionUUID->"835d6aeb-f7d6-b544-a9dc-49d3b081afab"],

Cell["\<\
pyDotN[pattern, {dims0, dims1, \[Ellipsis]}]: build N operands x0,x1,\
\[Ellipsis] from their dims
recipes inside Python and apply einx.dot.\
\>", "Text",
 CellID->504245297,ExpressionUUID->"a9def140-b2af-4b4f-af43-2f46ecba22f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pyDotN", "[", 
   RowBox[{"pattern_", ",", "dimsList_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"setup", ",", "args"}], "}"}], ",", 
    RowBox[{
     RowBox[{"setup", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nm", "=", 
               RowBox[{"\"\<x\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "#2", "]"}], "-", "1"}], "]"}]}]}], ",", 
              RowBox[{"d", "=", "#1"}]}], "}"}], ",", 
            RowBox[{"nm", "<>", "\"\< = (1 + np.arange(\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Times", "@@", "d"}], "]"}], "<>", "\"\<)).reshape(\>\"",
              "<>", 
             RowBox[{"pyDims", "[", "d", "]"}], "<>", "\"\<)\\n\>\""}]}], 
           "]"}], "&"}], ",", "dimsList"}], "]"}], "]"}]}], ";", 
     RowBox[{"args", "=", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<x\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "dimsList", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ",", "\"\<, \>\""}], "]"}]}], ";", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"pySession", ",", 
       RowBox[{"\"\<import numpy as np, einx\\n\>\"", "<>", "setup", 
        "<>", "\"\<np.asarray(einx.dot(\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"pattern", ",", "InputForm"}], "]"}], "<>", "\"\<, \>\"", "<>",
         "args", "<>", "\"\<)).tolist()\>\""}]}], "]"}]}]}], "]"}]}]], "Input",\

 InitializationCell->True,
 CellID->284678503,ExpressionUUID->"ccc3da72-869b-d544-a6d9-af7d0e4e443f"],

