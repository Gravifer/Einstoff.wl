      RowBox[{"{",
       RowBox[{"{", "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"Range", "[", "3", "]"}], ",",
       RowBox[{"Range", "[", "3", "]"}], ",",
       RowBox[{"Range", "[", "3", "]"}]}], "}"}]}], "]"}], ",",
