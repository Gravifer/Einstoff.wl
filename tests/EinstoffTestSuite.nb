Cell["\<\
12c. Targeted direct sums are ArrayReduce target syntax, not structural Join \
syntax
(matching einx id/rearrange, which accepts bare (a + b) but rejects [(a + \
b)]).\
\>", "Text",
 CellID->210201037],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Quiet", "[",
  RowBox[{
   RowBox[{
    RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}], "[",
    RowBox[{
     RowBox[{
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"m_", ",", "a_"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"m_", ",", "b_"}], "}"}]}], "}"}], "\[RuleDelayed]",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"m", ",",
         FrameBox[
          RowBox[{"a", "\[CirclePlus]", "b"}],
          DefaultBaseStyle->"HighlightedInput",
          FrameStyle->None,
          StripOnInput->False]}], "}"}], "}"}]}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "6", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"ArrayReshape", "[",
        RowBox[{
         RowBox[{"Range", "[", "8", "]"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",",
   RowBox[{"{",
    StyleBox[
     RowBox[{"Einstoff", "::", "unsupp"}], "MessageName"], "}"}]}],
  "]"}]], "VerificationTest",
 CellID->30251106],

