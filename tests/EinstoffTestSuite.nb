Cell["Inner.wlt", "Section",
 CellID->61652624,ExpressionUUID->"35bee437-f4c7-9549-9152-d95166dc3aae"],

Cell["\<\
Tests for the generalized contraction Einstoff[Inner][mul, add] (cf. WL Inner).
Dot is the (Times, Plus) case; other (mul, add) have no einx equivalent and are
checked against native WL Inner. One file per lowering path under tests/.
Run via: wolframscript -script scripts/run-tests.wls
BeginTestSection/EndTestSection are MUnit markers; the runner loads MUnit`.\
\>", "Text",
 CellID->627402497,ExpressionUUID->"f80a5279-c6ed-9c4b-98da-97c495eeed24"],

Cell["Einstoff`Lowering`Inner", "Subsection",
 CellID->906210373,ExpressionUUID->"e6afb0f2-67d3-b741-b2c5-f40c9e55dfa9"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "m", ",", "n"}], 
  "]"}]], "Input",
 InitializationCell->True,
 CellID->798201735,ExpressionUUID->"901c0fd8-2b93-b644-bace-ad31d69c20d6"],

Cell["1. Inner[Times, Plus] is exactly Dot (matmul).", "Text",
 CellID->105229649,ExpressionUUID->"dcd8af1d-924a-e246-a328-3938fe1e099b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"y", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "12", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Inner", "]"}], "[", 
     RowBox[{"Times", ",", "Plus"}], "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",", 
     RowBox[{"{", 
