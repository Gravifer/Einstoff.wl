Notebook[{Cell[CellGroupData[{Cell["Einstoff", "GuideTitle", CellID -> 300001],
     Cell["Einstoff is one public symbol with several operator forms. Choose an operator below, \
then describe input and output axes using Wolfram-native pattern and wrapper syntax. The \
description is compiled to a private staged representation before tensor execution.",
      "GuideAbstract", CellID -> 300002]}]],
  Cell[CellGroupData[{Cell["Structural transformations", "GuideFunctionsSection",
      CellID -> 300003], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[ArrayReshape]",
           BaseStyle -> "Link", ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]],
         "InlineGuideFunction"],
        " \[LongDash] perform element-count-preserving rearrangement and reshape"}], "GuideText",
      CellID -> 300004], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[\"Massage\"]",
           BaseStyle -> "Link", ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]],
         "InlineGuideFunction"],
        " \[LongDash] use the permissive single-tensor structural engine"}], "GuideText",
      CellID -> 300005], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[\"ArrayContract\"]",
           BaseStyle -> "Link", ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]],
         "InlineGuideFunction"],
        " \[LongDash] reshape and perform within-tensor pairwise contraction without repetition"}],
      "GuideText", CellID -> 300006],
     Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Join]", BaseStyle -> "Link",
           ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]], "InlineGuideFunction"],
        " \[LongDash] concatenate structural direct sums"}], "GuideText", CellID -> 300007],
     Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Split]", BaseStyle -> "Link",
           ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]], "InlineGuideFunction"],
        " \[LongDash] split structural direct sums"}], "GuideText", CellID -> 300008]}]],
  Cell[CellGroupData[{Cell["Reduction and mapped operations", "GuideFunctionsSection",
      CellID -> 300009], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[ArrayReduce][f]",
           BaseStyle -> "Link", ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]],
         "InlineGuideFunction"], " \[LongDash] reduce selected axes using f"}], "GuideText",
      CellID -> 300010], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Operate][f]",
           BaseStyle -> "Link", ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]],
         "InlineGuideFunction"],
        " \[LongDash] apply a shape-preserving operation to targeted blocks"}], "GuideText",
      CellID -> 300011],
     Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Map][f]", BaseStyle -> "Link",
           ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]], "InlineGuideFunction"],
        " \[LongDash] map a possibly shape-changing function over targeted blocks"}], "GuideText",
      CellID -> 300012]}]],
  Cell[CellGroupData[{Cell["Contractions", "GuideFunctionsSection", CellID -> 300013],
     Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Dot]", BaseStyle -> "Link",
           ButtonData -> "paclet:Gravifer/Einstoff/ref/Einstoff"]], "InlineGuideFunction"],
        " \[LongDash] perform sum-of-products contraction over two or more tensors"}], "GuideText",
      CellID -> 300014], Cell[TextData[{Cell[BoxData[ButtonBox["Einstoff[Inner][mul, add]",
