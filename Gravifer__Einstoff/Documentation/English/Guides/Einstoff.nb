Notebook[{CellGroupData[{Cell["Einstoff", "GuideTitle", CellID -> 300001], 
    Cell["Einstoff provides a Wolfram-native, declarative notation for \
rearranging, reducing, mapping, contracting, broadcasting, joining, and \
splitting tensor axes. Shape descriptions use familiar pattern forms at the \
surface and compile to a private staged representation before execution.", 
     "GuideAbstract", CellID -> 300002]}, Open], 
  CellGroupData[{Cell["Structural transformations", "GuideFunctionsSection", 
