Notebook[{CellGroupData[{Cell["Einstoff", "ObjectName", CellID -> 200001],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " performs an element-count-preserving rearrangement of tensors according to desc."}],
     "Usage", CellID -> 200002],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"Massage\"", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " uses the permissive single-tensor structural engine."}], "Usage", CellID -> 200003],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"ArrayContract\"", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " performs within-tensor pairwise contraction together with reshaping."}], "Usage",
     CellID -> 200004],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[",
             "f", "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " reduces selected axes of one tensor using f."}], "Usage", CellID -> 200005],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Operate", "]"}], "[",
             "f", "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " applies a shape-preserving operation f to targeted blocks."}], "Usage", CellID -> 200006],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Map", "]"}], "[", "f",
             "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " maps a possibly shape-changing operation f over targeted blocks."}], "Usage",
     CellID -> 200007],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " performs sum-of-products contraction over two or more tensors."}], "Usage",
     CellID -> 200008],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Inner", "]"}], "[",
             RowBox[{"mul", ",", "add"}], "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]],
        "InlineFormula"], " performs generalized contraction using mul and add."}], "Usage",
     CellID -> 200009],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Join", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " concatenates structural direct sums."}], "Usage", CellID -> 200010],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Split", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " splits structural direct sums."}], "Usage", CellID -> 200011],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"einsum\"", "]"}], "[",
           RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
       " dispatches the implemented einsum-style contraction subset."}], "Usage",
     CellID -> 200012],
    Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "op", "]"}], "[",
           RowBox[{"desc", ",", "tensors", ",", "bindings"}], "]"}]], "InlineFormula"],
       " uses explicit axis-size bindings in addition to sizes inferred from desc."}], "Usage",
     CellID -> 200013], Cell["The canonical description is a RuleDelayed of the form {in1, in2, \
...} :> {out1, out2, ...}. Rule is warned best-effort compatibility because its right-hand side may \
evaluate before capture.", "Notes", CellID -> 200014], Cell["Axis terms include named blanks, bare \
or string names, literal and unit axes, products, direct sums, named or anonymous sequences, and \
repeated groups.", "Notes", CellID -> 200015], Cell["The whole left-hand side is one binder scope: \
repeated a_ occurrences denote the same logical axis, while a bare a on the left remains an ambient \
expression. A bare a is localized only on the right from the completed binder environment or an \
explicit sized declaration.", "Notes", CellID -> 200016], Cell["Annotation[axis, n] and Labeled[n, \
axis] add an inline positive-integer size. They compose in either nesting order with valid Slot, \
Highlighted, and Framed targeting wrappers.", "Notes", CellID -> 200017],
    Cell["Targeted string axes use Slot[\"name\"], Highlighted[\"name\"], or Framed[\"name\"]. \
Targeted symbol axes use Highlighted or Framed.", "Notes", CellID -> 200018],
    Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "TraceAction", "None",
         Cell["Use Hold or Defer to inspect the lowered Wolfram expression.", "TableText"]},
        {Cell["      ", "TableRowIcon"], "\"Targeting\"", "Automatic", Cell["Use False, Automatic, \
