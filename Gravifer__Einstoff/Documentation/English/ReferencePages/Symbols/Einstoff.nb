            "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]uses the permissive single-tensor structural engine.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"ArrayContract\"",
              "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"], " \
\[LineSeparator]performs within-tensor pairwise contraction together with reshaping.", "\n",
        Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", ButtonBox["ArrayReduce",
                 BaseStyle -> "Link", ButtonData -> "paclet:ref/ArrayReduce"], "]"}], "[", "f",
              "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]reduces selected axes of one tensor using f.", "\n",
        Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", ButtonBox["Operate", BaseStyle ->
                  "Link", ButtonData -> "paclet:ref/Operate"], "]"}], "[", "f", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]applies a shape-preserving operation f to targeted blocks.", "\n",
        Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", ButtonBox["Map", BaseStyle -> "Link",
