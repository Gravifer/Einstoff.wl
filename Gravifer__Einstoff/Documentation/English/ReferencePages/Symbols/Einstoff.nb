Notebook[{Cell[CellGroupData[{Cell["Einstoff", "ObjectName", CellID -> 200001],
     Cell[TextData[{Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"], " \[LineSeparator]performs \
an element-count-preserving rearrangement of tensors according to desc.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"Massage\"", "]"}],
            "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]uses the permissive single-tensor structural engine.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"ArrayContract\"",
              "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"], " \
\[LineSeparator]performs within-tensor pairwise contraction together with reshaping.", "\n",
        Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "ArrayReduce", "]"}], "[", "f",
              "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]reduces selected axes of one tensor using f.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Operate",
                "]"}], "[", "f", "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]],
         "InlineFormula"],
        " \[LineSeparator]applies a shape-preserving operation f to targeted blocks.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Map", "]"}],
              "[", "f", "]"}], "[", RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]maps a possibly shape-changing operation f over targeted blocks.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Dot", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]performs sum-of-products contraction over two or more tensors.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{RowBox[{"Einstoff", "[", "Inner",
                "]"}], "[", RowBox[{"mul", ",", "add"}], "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]performs generalized contraction using mul and add.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Join", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]concatenates structural direct sums.", "\n", Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "Split", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]splits structural direct sums.", "\n", Cell["   ", "ModInfo"],
        Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "\"einsum\"", "]"}], "[",
            RowBox[{"desc", ",", "tensors"}], "]"}]], "InlineFormula"],
        " \[LineSeparator]dispatches the implemented einsum-style contraction subset.", "\n",
        Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{"Einstoff", "[", "op", "]"}], "[",
            RowBox[{"desc", ",", "tensors", ",", "bindings"}], "]"}]], "InlineFormula"], " \
\[LineSeparator]uses explicit axis-size bindings in addition to sizes inferred from desc."}],
      "Usage", CellID -> 200002], Cell["The canonical description is a RuleDelayed of the form \
{in1, in2, ...} :> {out1, out2, ...}. Rule is warned best-effort compatibility because its \
right-hand side may evaluate before capture.", "Notes", CellID -> 200003],
     Cell["Axis terms include named blanks, bare or string names, literal and unit axes, products, \
direct sums, named or anonymous sequences, and repeated groups.", "Notes", CellID -> 200004],
     Cell["The whole left-hand side is one binder scope: repeated a_ occurrences denote the same \
logical axis, while a bare a on the left remains an ambient expression. A bare a is localized only \
on the right from the completed binder environment or an explicit sized declaration.", "Notes",
      CellID -> 200005], Cell["Annotation[axis, n] and Labeled[n, axis] add an inline \
positive-integer size. They compose in either nesting order with valid Slot, Highlighted, and \
Framed targeting wrappers.", "Notes", CellID -> 200006], Cell["Targeted string axes use \
Slot[\"name\"], Highlighted[\"name\"], or Framed[\"name\"]. Targeted symbol axes use Highlighted or \
Framed.", "Notes", CellID -> 200007],
     Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "TraceAction", "None",
          Cell["Use Hold or Defer to inspect the lowered Wolfram expression.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"Targeting\"", "Automatic", Cell["Use False, Automatic, \
or True to control inference and validation of explicitly targeted axes.", "TableText"]}}]],
      "3ColumnTableMod", GridBoxOptions -> {GridBoxBackground -> {"Columns" -> {{None}},
          "Rows" -> {None, {None}}}, GridBoxDividers -> {"Rows" -> {{True, True, True}}}},
