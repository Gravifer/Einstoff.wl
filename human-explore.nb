Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff`Tests`$PySession", "=", "None"}], ";", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"exe", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "root", ",", "\"\<.venv\>\"", ",", "\"\<Scripts\>\"", 
         ",", "\"\<python.exe\>\""}], "}"}], "]"}]}], "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", "exe", "]"}], ",", 
      RowBox[{"Einstoff`Tests`$PySession", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"StartExternalSession", "[", 
           RowBox[{"Association", "[", 
            RowBox[{
             RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
             RowBox[{"\"\<Executable\>\"", "\[Rule]", "exe"}]}], "]"}], "]"}],
           ",", "None"}], "]"}], "]"}]}]}], "]"}]}], "]"}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[3]:=",
