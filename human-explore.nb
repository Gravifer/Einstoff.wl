    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a_", ",", 
         RowBox[{"Highlighted", "[", "b_", "]"}]}], "}"}], "}"}], "\[RuleDelayed]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], "}"}]}], ",", 
