Cell[BoxData[
 TemplateBox[{
  "Einstoff", "unsupp", 
   "\"\\!\\(\\*RowBox[{\\\"\\\\\\\"an input axis of size > 1 is dropped on \
the output; that is reduce, not rearrange/contract (a size-1 unit axis is \
squeezed; a literal size > 1 axis has no carryable identity; name it); use \
Einstoff[ArrayReduce]\\\\\\\"\\\"}]\\)\"", 2, 5, 1, 30414818749060473424, 
   "Local", "Einstoff`Einstoff"},
