Cell[TextData[{
 "Steering into it wisely means flexible striding and leads to an impressive ",
 ButtonBox["gallery",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einops.rocks/1-einops-basics/#fancy-examples-in-random-\
order"], None},
  ButtonNote->
   "https://einops.rocks/1-einops-basics/#fancy-examples-in-random-order"],
 "."
}], "Text",
ExpressionUUID->"cf8ad989-ac17-3f45-8cf7-a23e7d64cea7"],

Cell[TextData[{
 "The author of ",
 ButtonBox["einx",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einx.readthedocs.io/"], None},
  ButtonNote->"https://einx.readthedocs.io/"],
 " makes the excellent observation that one may ",
 StyleBox["read the axis labels mentally as loop index variables",
  FontSlant->"Italic"],
 ": inner ones go to the right of outer ones;\[LineSeparator]and based on an \
extensive ",
 ButtonBox["survey",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einx.readthedocs.io/en/stable/comparison/ein.html#:~:text=\
Other%20tensor%20notations"], None},
  ButtonNote->
   "https://einx.readthedocs.io/en/stable/comparison/ein.html#:~:text=Other%\
20tensor%20notations"],
 " of prior-art, they designed and implemented a more universal notation.\n\
Some outstanding features of ",
 Cell[BoxData[
  FormBox["einx", TraditionalForm]],ExpressionUUID->
  "b70f0555-26bf-514b-9fca-b5a8cc1865e4"],
 " are"
}], "Text",
ExpressionUUID->"2cd28f81-421a-fd48-a2f9-f8b886063929"],

Cell[CellGroupData[{

Cell[TextData[{
 "Immediate ",
 ButtonBox["literal",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einx.readthedocs.io/en/stable/gettingstarted/advanced.html#\
numerical-axes"], None},
  ButtonNote->
   "https://einx.readthedocs.io/en/stable/gettingstarted/advanced.html#\
numerical-axes"],
 " axes"
}], "Item",
ExpressionUUID->"d729b9fa-c006-bf41-901d-8444b7f1fb71"],

Cell[CellGroupData[{

Cell["\<\
import einx

y = einx.id(\"a b -> a b 3\", x)
# same as
y = einx.id(\"a b -> a b c\", x, c=3)
# or
from einops import repeat
repeat(x, \"a b -> a b c\", c=3)\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[35]:=",ExpressionUUID->"46975194-e810-1f46-83f7-bb487ca48f79"],

