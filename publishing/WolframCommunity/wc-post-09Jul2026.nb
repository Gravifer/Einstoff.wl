Cell[TextData[{
 "Eins",
 StyleBox["\[VeryThinSpace]nein",
  FontSlant->"Italic"],
 " notation"
}], "Subsection",
ExpressionUUID->"bd22bf09-c8f7-d247-bec3-e706e60a8adb"],

Cell[TextData[{
 "Having the axes of multi-dimensional arrays named is expressive and \
self-documenting,\[LineSeparator]so people have tried to generalize it to \
operations other than ",
 Cell[BoxData[
  FormBox[
   ButtonBox["Inner",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inner"], TraditionalForm]],ExpressionUUID->
  "c367eecf-f625-444f-a98e-724dc1597575"],
 " contractions, like reshaping or reduction.\[LineSeparator]Enter ",
 ButtonBox["einops",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einops.rocks/"], None},
  ButtonNote->"https://einops.rocks/"],
 ":"
}], "Text",
ExpressionUUID->"74384c68-cec4-3640-b1d2-edc0c0a04d2f"],

Cell[CellGroupData[{

Cell["\<\
from einops import rearrange

ims = np.array(<* ImageData /@ ims *>)

rearrange(ims[0], \"h w c -> w h c\") # equivalent to np.transpose(ims[0], \
(1, 0, 2))\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[23]:=",ExpressionUUID->"fb497f8e-f719-a846-aaa0-36b7a51f1c8b"],

