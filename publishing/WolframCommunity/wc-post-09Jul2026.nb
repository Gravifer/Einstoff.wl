Cell[TextData[{
 "At this point, the string descriptive has become a feature-rich pattern \
matching language, whose scope overlaps a surprising lot with WL ",
 ButtonBox["patterns",
  BaseStyle->"Link",
  ButtonData->"paclet:tutorial/PatternsAndTransformationRules"],
 ":"
}], "Text",
 CellFrame->False,
