(* Beginning of Notebook Content *)
Notebook[{
Cell[TextData[{
 "Hi! I\[CloseCurlyQuote]m experimenting with a project ",
 Cell[BoxData[
  FormBox[
   ButtonBox["Einstoff",
    BaseStyle->"Hyperlink",
    ButtonData->{
      URL["https://github.com/Gravifer/Einstoff.wl"], None},
    ButtonNote->"https://github.com/Gravifer/Einstoff.wl"], TraditionalForm]],
  ExpressionUUID->"2df98a3f-11f5-2140-9fab-49f4715e0a88"],
 "; \nit is inspired by ",
 ButtonBox["einops",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einops.rocks/"], None},
  ButtonNote->"https://einops.rocks/"],
 "/",
 ButtonBox["einx",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://einx.readthedocs.io/"], None},
  ButtonNote->"https://einx.readthedocs.io/"],
 ", but instead of parsing a string with syntax, \[LineSeparator]it uses \
native WL patterns as a eDSL to describe tensor operations like \
\[LineSeparator]reshaping, reducing, contracting, joining, and splitting \
multidimensional arrays"
}], "Text",ExpressionUUID->"cd375968-3c06-634f-9ca2-83edc76aee1c"],

Cell["Here are some basic examples:", "Text",ExpressionUUID->"603e4e8a-6dc3-4d44-b96c-2209a4634213"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ims", "=", 
  RowBox[{"MapIndexed", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ImageMultiply", "[", 
      RowBox[{"{", 
       RowBox[{"#1", ",", "\[IndentingNewLine]", 
        RowBox[{"Lighter", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "\"\<DefaultChartColors\>\"", "]"}], "@", 
           RowBox[{"First", "@", "#2"}]}], ",", ".7"}], "]"}]}], "}"}], "]"}],
      "\[IndentingNewLine]", "&"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Rasterize", "[", 
       RowBox[{"#", ",", 
        RowBox[{"RasterSize", "->", "56"}]}], "]"}], "&"}], "/@", 
     RowBox[{"Characters", "@", "\"\<Einstoff\>\""}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ImageData", "/@", "ims"}], "//", "Dimensions"}]}], "Input",
 PrivateCellOptions->{"CellSettings"-><|"ElisionEffect" -> "PaperTear"|>},
 CellSize->{Automatic, 44.70154541015625},
 CellLabel->"In[1]:=",ExpressionUUID->"c96505f5-fc7d-434c-bc43-8db27f3d80e1"],

