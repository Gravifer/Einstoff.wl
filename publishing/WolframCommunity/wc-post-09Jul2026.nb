Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6dda59e-6343-2548-a7af-8b828c8866b0"],
 " mostly does what ",
 Cell[BoxData[
  FormBox["Transpose", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "987a837f-0d33-324a-aaad-951c7fc9ba22"],
 " and ",
 Cell[BoxData[
  FormBox["ArrayReshape", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40520154-0e4c-7f4b-b26b-b7f1e4dd033b"],
 " do; you specify the shapes of the input and output tensors (mostly) \
symbolically,"
}], "Text",
ExpressionUUID->"3304ac71-9cae-7945-a1ef-cf5b649c5b3d"],

