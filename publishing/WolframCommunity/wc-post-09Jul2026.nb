Cell[CellGroupData[{

Cell["\<\
x = np.random.randn(640, 480, 3)

# Divide an image into a (flattened) list of 4x4 patches

y = einx.id(\"(s ds)... c -> (s...) ds... c\", x, ds=4)
# expands to
#   einx.id(\"(s1 ds1) (s2 ds2) c -> (s1 s2) ds1 ds2 c\", x, ds1=4, ds2=4)
y\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[44]:=",ExpressionUUID->"7261accc-8ee3-0b49-9f89-05952cb22c86"],

