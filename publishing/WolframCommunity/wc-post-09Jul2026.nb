Cell[CellGroupData[{

Cell["\<\
x = np.random.randn(10)
einx.sum(\"s... [c] -> s...\", x) # the same operation works, with variadic \
expressibility\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[41]:=",ExpressionUUID->"8728714a-9f4d-5b4d-8b2f-6a2423f2a168"],

Cell[BoxData[
 RowBox[{"-", "3.607727496115131`"}]], "Output",
 CellChangeTimes->{3.992601990691145*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"c7df55ba-7168-6d4f-b391-4ad63f4bd587"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
x = np.random.randn(10, 20)
y = np.random.randn(10, 20)

einx.add(\"s..., s... -> s...\", x, y) # naming the sequence allows repeated \
matching\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[42]:=",ExpressionUUID->"c3f87371-0f46-4e45-9698-d0bf248dbf62"],

