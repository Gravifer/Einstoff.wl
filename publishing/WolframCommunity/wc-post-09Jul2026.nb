Cell[TextData[{
 "Python and WL share the ",
 ButtonBox["row-major",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Row-_and_column-major_order#:~:text=\
lists%20of%20lists"], None},
  ButtonNote->
   "https://en.wikipedia.org/wiki/Row-_and_column-major_order#:~:text=lists%\
20of%20lists"],
 " convention when it comes to arrays, i.e., the later an axis comes, the \
more rapidly its index varies.\[LineSeparator]This means that the order of a \
parenthesized dimension matters: "
}], "Text",
ExpressionUUID->"b2bc0ff2-abc9-7544-890c-00c7bc965384"],

