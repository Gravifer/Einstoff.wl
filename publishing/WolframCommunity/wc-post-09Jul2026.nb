Cell[CellGroupData[{

Cell["\<\
x = np.random.randn(640, 480)

# Perform mean pooling with 4x4 patches (if evenly divisible)

y = einx.mean(\"(s [ds])...\", x, ds=4)
# expands to
#   einx.mean(\"(s1 [ds1]) (s2 [ds2]) -> s1 s2\", x, ds1=4, ds2=4)
y\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
