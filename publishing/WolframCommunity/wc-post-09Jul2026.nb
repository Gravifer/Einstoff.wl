Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"summary", "=", 
   RowBox[{"(", "\[IndentingNewLine]", GridBox[{
      {"\"\<a\>\"", "\"\<name\>\"", "\"\<axis identifier\>\"", 
       RowBox[{
       "HoldForm", "[", "a_", "]"}], "\"\<can have multiple occurrences\>\""},
      {"2", "\"\<numeric\>\"", "\"\<immediate literal\>\"", 
       RowBox[{
       "HoldForm", "[", "2", 
        "]"}], "\"\<distinct identity even when value coincides\>\""},
      {"\"\<_\>\"", "\"\<hole\>\"", "\"\<anonymous axis\>\"", 
       RowBox[{"HoldForm", "[", "_", "]"}], "\"\<\>\""},
      {"\"\<(a b)\>\"", "\"\<flattened\>\"", "\"\<composite as a direct \
product of dimensions\>\"", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"a", "\[CircleTimes]", "b"}], 
        "]"}], "\"\<need a non-comm head in WL; natural candidates are \
\[CircleTimes] and **\>\""},
      {"\"\<(a+b)\>\"", "\"\<concatenated\>\"", "\"\<composite as a direct \
sum of dimensions\>\"", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"a", "\[CirclePlus]", "b"}], 
        "]"}], "\"\<need a non-comm head in WL (like previous)\>\""},
      {"\"\<...\>\"", "\"\<ellipsis\>\"", "\"\<anonymous axis sequence\>\"", 
       RowBox[{
       "HoldForm", "[", "___", 
        "]"}], "\"\<WL also has the non-nullable \
\!\(\*Cell[\"__\",ExpressionUUID->\"86f55459-32eb-2c47-99b3-0d05f44afed4\"]\)\
\>\""},
      {"\"\<a...\>\"", "\"\<named ellipsis\>\"", "\"\<named sequence of \
axes\>\"", 
       RowBox[{"HoldForm", "[", "a___", "]"}], "\"\<(see previous)\>\""},
      {"\"\<\!\(\*StyleBox[\"\[LeftAngleBracket]\",FontSlant->\"Italic\"]\)\!\
\(\*StyleBox[\"pattern\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"\
\[RightAngleBracket]\",FontSlant->\"Italic\"]\)...\>\"", "\"\<sub-expr \
ellipsis\>\"", "\"\<pattern sequence\>\"", 
