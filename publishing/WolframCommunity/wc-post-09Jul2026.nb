Cell[CellGroupData[{

Cell["\<\
ra = np.random.randn(8,120,56,3)
rb = np.random.randn(8,120,56,3)
np.einsum('b ..., b ... -> ...', ra, rb) # dot product, batched with an \
anonymous sequence of axes\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
