Cell["\<\
And it\[CloseCurlyQuote]s also possible to use more verbose axis names, \
leading to well self-documenting code:\
\>", "Text",
ExpressionUUID->"23d82a97-c7ab-4a41-b040-f2a027432dad"],

Cell[CellGroupData[{

Cell["\<\
rearrange(ims, 'batch height width color -> height (batch width) color') # \
the `(batch width)` part means combining these into one axis, as a direct \
product\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
