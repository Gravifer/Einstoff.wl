Cell[CellGroupData[{

Cell["\<\
# by naming ellipses, they can match with different sequences

x = np.random.randn(10, 20)
y = np.random.randn(30, 40)

einx.add(\"a..., b... -> a... b...\", x, y) # equivalent to a batched \
`Outer[Plus,...]`\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[43]:=",ExpressionUUID->"e9c8db52-3200-3a49-b757-88ab4bbc10ab"],

