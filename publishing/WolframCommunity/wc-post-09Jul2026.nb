Cell[CellGroupData[{

Cell["\<\
from einops import reduce

# reducing an axis by taking the mean
reduce(ims, \"b h w c -> h w c\", \"mean\") # `b` is dropped from RHS, so it \
is averaged over; equivalent to np.mean(x, -1)\
\>", "ExternalLanguage",
 TaggingRules-><|
  "ExternalEvaluateData" -> <|
    "System" -> "Python", "SessionID" -> 
     "c9788ef9-e4dd-40cd-be36-87ce01a191b4", "Evaluator" -> 
     ExternalEvaluatorObject[<|
       "System" -> "Python", "Evaluator" -> 
        "C:\\Users\\user\\Desktop\\einstoff.wl\\.venv\\Scripts\\python.exe", 
        "EvaluatorID" -> "einstoff"|>]|>|>,
 CellEvaluationLanguage->"Python",
 CellLabel->"In[27]:=",ExpressionUUID->"4f7b08dc-f3b4-3a47-ac06-cb9f73fd9da7"],

