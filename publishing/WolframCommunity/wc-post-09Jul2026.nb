Cell[BoxData[
 RowBox[{
  RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"batch_", ",", "height_", ",", "width_", ",", "color_"}], "}"}],
      "}"}], ":>", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"height", ",", 
       RowBox[{"batch", "\[CircleTimes]", "width"}], ",", "color"}], "}"}], 
     "}"}]}], ",", 
   RowBox[{"{", 
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = False}, 
      TemplateBox[{"Expression", 
        RowBox[{"NumericArray", "[", 
          DynamicBox[
           FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], "]"}], 
        GridBox[{{
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["144", "IconizedItem"]}]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
         "Column", 
         GridBoxItemSize -> {
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
        Dynamic[Typeset`open]},
       "IconizedObject"]],
     NumericArray[
      Map[ImageData, $CellContext`ims], "Real64"],
     SelectWithContents->True,
     Selectable->False], "}"}], ",", 
   RowBox[{"TraceAction", "->", "Defer"}]}], "]"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"6786da15-8351-394e-9ccd-74a961474198"],

