Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Range", "[", "20", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10"}], "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Einstoff", "[", "Split", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"m_", ",", 
          RowBox[{"\"\<q\>\"", "\[CirclePlus]", "k_"}]}], "}"}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "\"\<q\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "k"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"{", "x", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<q\>\"", "->", "3"}], "}"}]}], "]"}], "===", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Take", "[", 
       RowBox[{"x", ",", "All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], ",", 
      RowBox[{"Take", "[", 
       RowBox[{"x", ",", "All", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "10"}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
