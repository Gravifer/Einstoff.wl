 CellTags->
  "DefaultContent",ExpressionUUID->"db2ea7cd-99f3-4db7-bc8c-136f9e7df777"],

Cell[TextData[{
 "This resource delegates through ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["PacletSymbol", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/PacletSymbol",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "afafb095-3e58-4028-9987-921594b87d7d"],
 " to the published Gravifer/Einstoff paclet, which requires Wolfram Language \
15.0 or later. Parsing, validation, planning and execution remain versioned \
in that paclet rather than being copied into this Resource Function."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996157510653302*^9, 3.996157511833103*^9}, 
   3.9961872781959667`*^9},
 CellTags->
  "DefaultContent",ExpressionUUID->"abde1c3a-6764-4411-999d-93e07cc00a45"],

Cell[TextData[{
 "For now, the ",
 StyleBox["Gravifer/Einstoff", "InlineCode"],
 " paclet requires Wolfram Language 15.0 or later; ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["PacletSymbol", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
