   StyleBox["flip",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "a0105ca3-0f39-4103-b10f-dc045b1187d1"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["reverse",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "e15e3631-5e45-47fd-8fe8-d725cb6ab4b3"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["sort",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "ac36ea71-d3b4-4842-8e9a-3b3eb66e8683"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["softmax",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "9b51c2db-2a32-4da4-87d1-87086caea645"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["log_softmax",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
