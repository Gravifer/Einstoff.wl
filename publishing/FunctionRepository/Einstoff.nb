Cell["\<\
from einops import rearrange

ims = np.array(<* ImageData /@ ims *>)

rearrange(ims[0], \"h w c -> w h c\") # equivalent to np.transpose(ims[0], \
(1, 0, 2))\
\>", "ExternalLanguage",
 TaggingRules-><|
