Cell[TextData[{
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["CircleTimes", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/CircleTimes",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1ad01b8-216f-4627-8f94-9f194a3f4e01"],
 " composes logical axes into one physical dimension. ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["CirclePlus", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/CirclePlus",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "32244981-933a-471f-8cd4-0698fe63a3ad"],
 " denotes a structural direct sum used by ",
 Cell[BoxData[
  RowBox[{"Einstoff", "[", 
   TagBox[
    ButtonBox[
     StyleBox["Join", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Join",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "775fac8e-4fb0-4e3d-af31-4b0a85309f16"],
 ", ",
 Cell[BoxData[
  RowBox[{"Einstoff", "[", 
   TagBox[
    ButtonBox[
     StyleBox["Split", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Split",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e3e4abcd-cec9-492f-b627-078b6c68a77b"],
 ", and the permissive ",
 Cell[BoxData[
  RowBox[{"Einstoff", "[", "\"\<Massage\>\"", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8b417660-0fb4-44a1-aaa3-9c54daaf1359"],
 ". Positive integers denote literal sizes, and 1 or an empty shape \
represents a unit axis where applicable."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9961851246797504`*^9, 3.9961851319971657`*^9}, 
   3.996185544485054*^9, {3.996552529763712*^9, 3.9965525486245728`*^9}},
 CellTags->
  "DefaultContent",ExpressionUUID->"eaef7ac5-4f0a-4a98-8a9e-9d8683ef452f"],

Cell[TextData[{
 "Targeted axes identify blocks consumed by reduction, contraction or mapped \
operations. String axes may be targeted with ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Slot", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Slot",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b152a8f-e903-4020-9347-259747b84695"],
 ", ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Highlighted", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Highlighted",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0abe089-1410-4cec-a0c7-e2fa70e8221d"],
 " or ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Framed", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Framed",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "603ddf47-ce66-48fc-9db0-76f27ce29a9d"],
 "; symbol axes use ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Highlighted", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Highlighted",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b09d06c0-d44b-4c11-adbd-99b99c295d9f"],
 " or ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Framed", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Framed",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9503c331-6007-4bd0-829f-d17feb5bce8b"],
 ". Targeting is occurrence metadata and does not change logical axis \
identity."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9961852942403984`*^9, 3.996185303711708*^9}},
 CellTags->
  "DefaultContent",ExpressionUUID->"0eee12e9-6ceb-490d-9293-1b736be4737f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Annotation", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Annotation",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["axis", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bb9d1461-3634-4e0b-bce7-d1eef22d9281"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Labeled", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Labeled",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    StyleBox["axis", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "692a1e06-2d80-4e40-be8c-9ccbbf5a7d65"],
 " declare an inline positive-integer size on either side of a description. \
They compose in either nesting order with valid targeting wrappers. A sized \
blank both infers its size and checks equality with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "77138b1e-25c8-4f7e-a470-d1cb4835b277"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996185319913021*^9, 3.996185327642975*^9}},
 CellTags->
  "DefaultContent",ExpressionUUID->"be60c921-e570-4414-81ef-35e81106d3c8"],

Cell[TextData[{
 "Explicit bindings are supplied as a list of rules, for example ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<\!\(\*StyleBox[\"channels\", \"TI\"]\)\>\"", "->", "3"}], 
   "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0986621-31a2-46e3-ba66-e3e84c4b7ab6"],
 ". Symbol and string spellings for one logical name may not be mixed, and \
inference-only blank spellings are not valid out-of-band binding keys."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{3.9961853321803913`*^9},
 CellTags->
  "DefaultContent",ExpressionUUID->"cc0a3e95-f02d-41e3-be6e-4fe4cf5a865e"],

Cell[TextData[{
 "For the operator selectors ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["ArrayReshape", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/ArrayReshape",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "80838383-6931-4fcf-8900-fe0d84ad543b"],
 ", ",
 Cell[BoxData[
  FormBox["\"\<Massage\>\"", TraditionalForm]],ExpressionUUID->
  "43f42105-277c-4bc4-bfe6-ff4ca8f55505"],
 ", ",
 Cell[BoxData[
  FormBox["\"\<ArrayContract\>\"", TraditionalForm]],ExpressionUUID->
  "3fd45769-3a73-4f07-ba26-6c39afd3a4a4"],
 ", ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["ArrayReduce", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/ArrayReduce",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "75b2ed82-af75-4f9c-9300-d62c138674f8"],
 ", ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Dot", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Dot",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eb37484e-10f6-4df6-9b54-e5af1d079717"],
 ", ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Inner", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Inner",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1d875c15-62a2-491a-83b6-81f10a0dad9d"],
 " and ",
 Cell[BoxData[
  FormBox["\"\<einsum\>\"", TraditionalForm]],ExpressionUUID->
  "13be5b86-0065-4bbd-b766-1a1fdff3bce5"],
 ", the option ",
 Cell[BoxData[
  FormBox["\"\<Targeting\>\"", TraditionalForm]],ExpressionUUID->
  "68f64b39-a33b-4b33-ad3c-b351026ee315"],
 " accepts ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["True", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/True",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "697f79e4-927e-4f98-ac21-db538db52893"],
 ", ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["False", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/False",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9408d5ba-2c81-4987-b154-d4cd0a93fe9a"],
 " or ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Automatic", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Automatic",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c48b2ae7-ae42-4d86-937c-e1ae179dedde"],
 " to control whether operated axes are inferred, checked against explicit \
targets, or required explicitly. ",
 Cell[BoxData[
  RowBox[{"TraceAction", "->", 
   TagBox[
    ButtonBox[
     StyleBox["Hold", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Hold",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5d742b6f-9587-43c6-acf5-bec319ea6095"],
 " or ",
 Cell[BoxData[
  RowBox[{"TraceAction", "->", 
   TagBox[
    ButtonBox[
     StyleBox["Defer", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Defer",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3c07ad91-6347-4b4f-b5f5-76587d05f4f4"],
 " returns the lowered Wolfram expression instead of executing it normally."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996185339641577*^9, 3.996185394740734*^9}, {
  3.996185824027443*^9, 3.996185829644884*^9}, {3.996330468235157*^9, 
  3.9963305040109863`*^9}, {3.9965489118292847`*^9, 3.9965489348856792`*^9}},
 CellTags->
  "DefaultContent",ExpressionUUID->"55a2429e-d6b0-46d9-a5ab-14420a1c0426"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Einstoff", "[", 
   TagBox[
    ButtonBox[
     StyleBox["ArrayReduce", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/ArrayReduce",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3d588031-4417-4260-a3a1-e0f6fbede679"],
 " accepts either a Wolfram reducer or a case-insensitive recipe name: ",
 Cell[BoxData[
  FormBox[
   StyleBox["sum",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "18da83c5-171a-469a-b0d9-3b564254ce27"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["total",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "bb41efe9-7b60-4a3a-b58f-e8923dc41051"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["add",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "b6017f5d-f53d-4d06-8c95-79616d201666"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["mean",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "f752da68-e662-4eb0-9a20-efd687154ecf"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["average",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "a0a665f6-e44b-43fa-8f93-ccbbf3f6dd1f"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["max",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "814e2d36-2f55-4e86-bc13-99fb1b47788d"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["min",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "e7490bc4-b79f-4592-8e93-1cf86c274c81"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["prod",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "01349465-26ed-4561-aa0b-7f657c8d7f77"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["product",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "8fb0f4af-e4da-40d1-abf6-a009cb9d983d"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["times",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "7c8767c0-859e-441e-a84f-4608b2eadb57"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["var",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "4e34f935-8b1a-4cce-b483-535f221c9117"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["variance",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "e37c8ee9-d2ce-4d25-bc08-5cf79d8eb797"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["std",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "6c9e7922-cafe-40b9-8ed0-679894637511"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["stddev",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "f1cb4bd5-07aa-4e32-a004-4e02366e127b"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["count_nonzero",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "f3405d95-5e53-4b4e-92f7-48324a701fdd"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["countnonzero",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "9e9a4e12-8630-4cfe-bc14-b6b31066f602"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["any",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "0e8bdf93-f0f2-4f9a-8101-dafa0f008e0f"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["all",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "7783c2bb-796a-40ff-9e5c-3cd103ff32e5"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["logsumexp",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "15ff60d7-7a76-476e-971c-a2373c58fe42"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox["lse",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "99b7f80b-4670-418c-826f-d5ce3f011326"],
 ". Variance and standard deviation use population normalization, and any/all \
test whether elements are nonzero."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9961856524771347`*^9, 3.996185705626356*^9}},
 CellTags->
  "DefaultContent",ExpressionUUID->"239435a6-116b-4d44-9381-30f07943e506"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Einstoff", "[", 
   TagBox[
    ButtonBox[
     StyleBox["Operate", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
