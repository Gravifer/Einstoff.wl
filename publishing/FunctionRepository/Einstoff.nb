Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Range", "[", "6", "]"}], ",", 
