   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8913e170-37f3-474a-9316-254a26938d7f"],
 " cannot resolve this resource on an older system."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9961859180400887`*^9},ExpressionUUID->"03a29e3a-ef65-4355-9d0b-\
3b5b341f1375"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["RuleDelayed", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/RuleDelayed",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bf817113-c9a5-49fc-bdbd-dfc80acc0ad8"],
 " for descriptions. ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Rule", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Rule",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7a2af38-e95b-424c-99cf-adaee50c7bc9"],
 " may evaluate its right-hand side before ",
 Cell[BoxData["Einstoff"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0e3fa68b-3d38-4f3a-98cf-5965c20ca344"],
 " captures the description and is supported only on a best-effort basis."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.996185847116518*^9},ExpressionUUID->"e968e189-a672-4a32-818a-\
501347e2ffa8"],

Cell[TextData[{
 "Bare symbols on the left-hand side are ambient expressions, not references \
to another blank of the same spelling. Use ",
 Cell[BoxData[
  StyleBox["a_", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dac1030f-abbe-47a8-9ef1-7fc40bbc0ec8"],
 " to bind an inferred axis and use bare ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "20e5e247-6c86-4717-8867-ab38a2dc8c04"],
 " on the right-hand side to reference that completed binding."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9961858630947304`*^9, 
  3.9961858734372253`*^9}},ExpressionUUID->"6862311b-985f-404b-ad9d-\
981730093198"],

Cell[TextData[{
 "String axes are hygienic and immune to ambient symbol values. Keep explicit \
bindings in a list, for example ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"\"\<\!\(\*StyleBox[\"channels\", \"TI\"]\)\>\"", "->", "3"}], 
    "}"}], TraditionalForm]],ExpressionUUID->
  "3e917012-edf4-4ec3-9fdd-089f1055bc7f"],
 "."
}], "Notes",
