      ButtonData->"paclet:ref/RotateLeft",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"#", ",", 
     StyleBox["k", "TI"]}], "]"}], "&"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3dbe3fb8-cc63-48f1-88a3-e80f0a7891f4"],
 "."
}], "Notes",
 TaggingRules->{},
