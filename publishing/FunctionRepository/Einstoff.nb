         RowBox[{"{", 
          RowBox[{"a_", ",", "b_"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b_", ",", "c_"}], "}"}]}], "}"}], "\[RuleDelayed]", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"a", ",", "c"}], "}"}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "===", 
    RowBox[{
     RowBox[{
      RowBox[{"Einstoff", "[", "Inner", "]"}], "[", 
      RowBox[{"Times", ",", "Plus"}], "]"}], "[", 
     RowBox[{
      RowBox[{
