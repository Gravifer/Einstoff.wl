Cell[CellGroupData[{

Cell["\<\
x = np.random.randn(10, 20)
y = np.random.randn(10, 20)

einx.add(\"s..., s... -> s...\", x, y) # naming the sequence allows repeated \
matching\
\>", "ExternalLanguage",
