Cell["Create a banner saying \"Einstoff\":", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9960296192587204`*^9, 3.9960296280028934`*^9}, {
  3.996030720694086*^9, 
  3.9960307210431747`*^9}},ExpressionUUID->"66c36ccb-92f8-4ee5-a8cf-\
8753ec07c241"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ims", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ImageMultiply", "[", 
       RowBox[{"{", 
        RowBox[{"#1", ",", "\[IndentingNewLine]", 
         RowBox[{"Lighter", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "\"\<DefaultChartColors\>\"", "]"}], "@", 
            RowBox[{"First", "@", "#2"}]}], ",", ".7"}], "]"}]}], "}"}], 
       "]"}], "\[IndentingNewLine]", "&"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Rasterize", "[", 
        RowBox[{"#", ",", 
         RowBox[{"RasterSize", "->", "56"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Characters", "@", "\"\<Einstoff\>\""}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Einstoff", "[", "ArrayReshape", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"batch_", ",", "height_", ",", "width_", ",", "color_"}], 
       "}"}], "}"}], ":>", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"height", ",", 
        RowBox[{"batch", "\[CircleTimes]", "width"}], ",", "color"}], "}"}], 
      "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ImageData", "/@", "ims"}], "}"}]}], "]"}], "//", 
  "Image"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9960295490528507`*^9, 3.996029600393093*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"697ca637-c5cb-450d-9849-f765af90884c"],

