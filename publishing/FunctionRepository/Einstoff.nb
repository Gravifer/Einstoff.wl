Cell[TextData[{
 "A description is normally a ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["RuleDelayed", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/RuleDelayed",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8e753538-0fc2-4afa-bc74-5e203943e755"],
 " expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["inputShape", "TI"], "1"], ",", " ", 
      SubscriptBox[
       StyleBox["inputShape", "TI"], "2"], ",", " ", "\[Ellipsis]"}], "}"}], 
    " ", ":>", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["outputShape", "1"], ",", " ", 
      SubscriptBox[
       StyleBox["outputShape", "TI"], "2"], ",", " ", "\[Ellipsis]"}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "c72eb2b2-397e-4119-9ad7-389a8a698c50"],
 ". Each shape is a list of dimension terms, and tensors is a list whose \
arity agrees with the input shapes."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9960305999191113`*^9, 3.9960306371320744`*^9}, {
   3.9960315740397415`*^9, 3.9960315795753975`*^9}, 3.996184468085432*^9},
 CellTags->
  "DefaultContent",ExpressionUUID->"dd6fe7dd-aab0-464f-9083-926a1791cd4e"],

Cell[TextData[{
 "On the complete left-hand side, ",
 Cell[BoxData[
  StyleBox["a_", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "71e28678-5af7-4210-bf84-27842b53476e"],
 " binds and infers the logical axis ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bdb03bd7-c7d6-49d2-bd1a-abeb948de3ef"],
 ". Repeated occurrences of ",
 Cell[BoxData[
  StyleBox["a_", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6c38582c-33e9-47ea-b6b7-1a4f7095870a"],
 " denote the same logical axis and must have equal size. A bare a on the \
left remains an ambient expression; a bare ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ececb7d3-ca25-4d42-b341-f80012232248"],
 " on the right references the completed left-hand-side binding."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9961578087008743`*^9, 3.9961578217873573`*^9}, 
   3.9961854314708424`*^9},
 CellTags->
  "DefaultContent",ExpressionUUID->"d4b1ef6e-7ceb-4564-9538-62746dc9e9bc"],

Cell[TextData[{
 "String axes such as \"channels\" are ",
 ButtonBox["hygienically scoped",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Hygienic_macro"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Hygienic_macro"],
 " names that are independent of symbol values. Anonymous blanks infer \
unnamed axes, while ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["BlankSequence", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/BlankSequence",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f067b16-63c9-4ae6-b8b2-786f4f5582cc"],
 " and ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["BlankNullSequence", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/BlankNullSequence",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c88eb1c9-71df-4b6e-a903-79820cb273e6"],
 " describe one-or-more and zero-or-more axis sequences."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996185115331011*^9, 3.9961851192583637`*^9}, {
  3.996329030512209*^9, 3.996329045554777*^9}, {3.996329098115015*^9, 
