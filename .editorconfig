# EditorConfig: https://editorconfig.org/

# Top-most EditorConfig file.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{wl,wls,wlt}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 4

[*.toml]
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{nb,lock}]
insert_final_newline = false
trim_trailing_whitespace = false
